#!/usr/bin/env luajit
-- dune-idle-throttle: lowers the map server's frame cap (t.MaxFPS) while nobody is connected, to save CPU, and restores
-- it on the first connection. Measured on an idle world: 39% of one core at the game's 20 fps, 12.7% at 5, 4.3% at 1.
-- Presence = established TCP connections to the game broker's TLS port from non-loopback peers (ss); the world's own
-- components connect over loopback. Rates change through `dune-live world cvar t.MaxFPS N` (set and verified). Logic
-- lives in lib/idle_throttle.lua (pure); this file does the I/O: ss, dune-live, the notifier, pid/state/log files.
-- Usage: dune-idle-throttle start|stop|status | run [--polls N] [--virtual-clock T]
local ffi = require("ffi")
ffi.cdef [[
char *realpath(const char *path, char *resolved);
void free(void *p);
int getpid(void);
int kill(int pid, int sig);
]]

local NAME, VERSION = "dune-idle-throttle", "0.1.0"
local EXIT_OK, EXIT_ERR, EXIT_USAGE = 0, 1, 2
local STOP_WAIT_SECONDS = 15
local EPERM = 1
local NOTIFY_AS = "dune_awakening_server"

local function self_path()
	local r = ffi.C.realpath(arg[0], nil)
	if r == nil then return arg[0] end
	local s = ffi.string(r); ffi.C.free(r)
	return s
end
local SELF = self_path()
local DIR = SELF:match("^(.*)/[^/]*$") or "."
package.path = DIR .. "/lib/?.lua;" .. package.path
local it = require("idle_throttle")

local USAGE = [[
Usage: dune-idle-throttle start|stop|status
       dune-idle-throttle run [--polls N] [--virtual-clock T]

Lowers the map server's frame cap while nobody is connected, to save CPU, in two tiers, and restores it as soon as
a player connects: active (ACTIVE_FPS) -> idle (IDLE_FPS, after IDLE_AFTER seconds with nobody connected) -> deep
idle (DEEP_IDLE_FPS, after DEEP_IDLE_AFTER seconds). It checks every IDLE_POLL seconds, every DEEP_IDLE_POLL seconds
in deep idle. While in deep idle it sends a notice every DEEP_IDLE_NOTICE seconds that the world is still up.
A player counts as connected while their game client holds a connection to the game broker (DUNE_RMQ_GAME_PORT)
from another address than this host's loopback. Nothing is lowered until IDLE_AFTER seconds after this component
or the map server starts. stop restores ACTIVE_FPS when the rate may be lowered.

Settings: world.conf keys, or DUNE_<key> environment variables, which win (defaults in parentheses):
  IDLE_THROTTLE (1)        0 = never change the rate (connections are still logged)
  ACTIVE_FPS (20)          the game's default cap
  IDLE_FPS (5)             IDLE_AFTER (300)
  DEEP_IDLE_FPS (1)        DEEP_IDLE_AFTER (86400)
  IDLE_POLL (10)           DEEP_IDLE_POLL (30)
  DEEP_IDLE_NOTICE (604800) seconds between deep-idle notices; 0 = none
  NOTIFY_TO                recipient of the notices (none: the notice is only logged)
  NOTIFY_CMD (post)        run as: NOTIFY_CMD to <NOTIFY_TO> --as dune_awakening_server --subject S --body B --yes

  start / stop / status  run in the background (component interface used by dune-awakening)
  run                    foreground; --polls N exits after N polls, --virtual-clock T starts a simulated clock at
                         T (seconds since 1970) that advances by the poll interval without sleeping (for tests)

Log and state: $DUNE_STATE_DIR/idle-throttle/. Environment: DUNE_STATE_DIR, DUNE_RMQ_GAME_PORT (default 31982),
DUNE_LIVE (default: dune-live next to this tool), DUNE_SS (default ss).
]]

local function die(code, fmt, ...)
	io.stderr:write(NAME, ": ", string.format(fmt, ...), "\n")
	os.exit(code)
end
local function getenv(k, default) local v = os.getenv(k); if v == nil or v == "" then return default end; return v end

local function read_file(p)
	local f = io.open(p, "rb"); if not f then return nil end
	local s = f:read("*a"); f:close(); return s
end

local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local function run_ok(cmd)
	local a, _, c = os.execute(cmd)
	if type(a) == "number" then return a == 0 end
	return a == true and (c == nil or c == 0)
end

-- Run argv (each element quoted, nothing shell-interpreted); returns ok and the combined output.
local function capture(argv)
	local parts = {}
	for i, a in ipairs(argv) do parts[i] = q(a) end
	local p = io.popen(table.concat(parts, " ") .. " 2>&1 </dev/null; printf '\\n%d' $?")
	local out = p:read("*a"); p:close()
	local body, code = out:match("^(.*)\n(%d+)$")
	body = (body or out):gsub("%s+$", "")
	if code ~= "0" and body == "" then body = "exit status " .. tostring(code) end
	return code == "0", body
end

local function last_line(out) return ((out or ""):match("([^\n]*)$") or ""):sub(1, 200) end

-- Paths ---------------------------------------------------------------------------------------------------------
local state_dir = getenv("DUNE_STATE_DIR", "")
local run_dir = state_dir .. "/idle-throttle"
local pid_file, log_file, state_file = run_dir .. "/pid", run_dir .. "/idle-throttle.log", run_dir .. "/state"
local server_pid_file = state_dir .. "/server/pid"
local LIVE = getenv("DUNE_LIVE", DIR .. "/dune-live")
local PORT = getenv("DUNE_RMQ_GAME_PORT", "31982")

local function alive(pid)
	pid = tonumber(pid)
	if not pid or pid <= 0 then return false end
	return ffi.C.kill(pid, 0) == 0 or ffi.errno() == EPERM
end

local function pid_running()
	local pid = (read_file(pid_file) or ""):match("^(%d+)")
	return pid and alive(pid) and pid or nil
end

-- The map server's identity: its pid while it runs, else nil.
local function server_id()
	local pid = (read_file(server_pid_file) or ""):match("^(%d+)")
	return pid and alive(pid) and pid or nil
end

local function ensure_dir() return run_ok("umask 077; mkdir -p " .. q(run_dir) .. " && chmod 700 " .. q(run_dir)) end

-- Log: private file, one line per event (never one per poll).
local log_fh
local function log(fmt, ...)
	if not log_fh then
		ensure_dir()
		run_ok("umask 077; touch " .. q(log_file) .. " && chmod 600 " .. q(log_file))
		log_fh = io.open(log_file, "a")
		if not log_fh then die(EXIT_ERR, "cannot write %s", log_file) end
	end
	log_fh:write(os.date("!%Y-%m-%dT%H:%M:%SZ"), " ", string.format(fmt, ...), "\n")
	log_fh:flush()
end

-- State file, replaced atomically.
local function save(state)
	ensure_dir()
	local tmp = state_file .. ".new"
	local f = io.open(tmp, "w")
	if not f then log("cannot write %s", tmp); return end
	f:write(it.encode(state)); f:close()
	os.rename(tmp, state_file)
end

local function config()
	local cfg, err = it.parse_config(os.getenv)
	if not cfg then die(EXIT_ERR, "invalid setting: %s (world.conf key or DUNE_ environment variable)", err) end
	return cfg
end

local function set_rate(fps) return capture({ LIVE, "world", "cvar", "t.MaxFPS", tostring(fps) }) end

-- Established connections on the broker port; nil, reason when ss fails.
local function connections()
	local ok, out = capture({ getenv("DUNE_SS", "ss"), "-Htn", "state", "established", "( sport = :" .. PORT .. " )" })
	if not ok then return nil, last_line(out) end
	return it.count_connections(out, PORT)
end

local function notify(cfg, action)
	local to = getenv("DUNE_NOTIFY_TO")
	if not to then log("deep idle notice (NOTIFY_TO not set, not sent): %s", action.subject); return true end
	local ok, out = capture({ getenv("DUNE_NOTIFY_CMD", "post"), "to", to, "--as", NOTIFY_AS, "--subject", action.subject,
		"--body", action.body, "--yes" })
	if ok then log("sent deep idle notice to %s: %s", to, action.subject)
	else log("deep idle notice failed (%s); retrying at the next poll", last_line(out)) end
	return ok
end

-- Foreground loop: observe, decide, act, persist; the clock is real (sleeping between polls) or virtual.
local function cmd_run(max_polls, virtual)
	local cfg = config()
	local socket = (not virtual) and require("socket") or nil
	local now = virtual or os.time()
	local st = it.initial_state(now, cfg, it.decode(read_file(state_file)), server_id())
	if cfg.enabled then
		log("started: active %d fps, idle %d fps after %d s, deep idle %d fps after %d s", cfg.active_fps, cfg.idle_fps,
			cfg.idle_after, cfg.deep_fps, cfg.deep_after)
	else
		log("started: off (IDLE_THROTTLE=0; connections are logged, the rate is left alone)")
	end
	local saved, failing, blind = nil, nil, nil
	local polls = 0
	while not max_polls or polls < max_polls do
		polls = polls + 1
		local n, err = connections()
		local poll = cfg.poll
		if not n then
			if blind ~= err then log("cannot list connections (%s); no change until it works", err) end
			blind = err
		else
			blind = nil
			local action, events
			st, action, poll, events = it.step(st, { connections = n, server = server_id() }, now, cfg)
			for _, e in ipairs(events) do log("%s", e) end
			if action and action.set_fps then
				save(it.applied(st, action, false, now)) -- the rate is unknown until the change is verified
				local ok, out = set_rate(action.set_fps)
				st = it.applied(st, action, ok, now)
				if ok then log("%s", action.message); failing = nil
				elseif failing ~= action.set_fps then
					log("could not set %d fps (%s); retrying at each poll", action.set_fps, last_line(out))
					failing = action.set_fps
				end
			elseif action and action.notify then
				st = it.notified(st, notify(cfg, action), now)
			end
			local text = it.encode(st)
			if text ~= saved then save(st); saved = text end
		end
		if max_polls and polls >= max_polls then break end
		if virtual then now = now + poll else socket.sleep(poll); now = os.time() end
	end
	log("stopping after %d polls", polls)
	return EXIT_OK
end

-- Put the active rate back when the state says it may be lowered on the map server that is running now.
local function restore()
	local cfg = it.parse_config(os.getenv) or it.parse_config(function() return nil end)
	local p = it.decode(read_file(state_file))
	local server = server_id()
	if not (p.server and server and p.server == server) or p.applied == cfg.active_fps then return true end
	local ok, out = set_rate(cfg.active_fps)
	if not ok then log("could not restore %d fps on stop (%s)", cfg.active_fps, last_line(out)); return false, last_line(out) end
	p.applied = cfg.active_fps
	save(p)
	log("restored %d fps (stopping)", cfg.active_fps)
	return true
end

local function cmd_start()
	if pid_running() then return EXIT_OK end
	config()
	if not ensure_dir() then die(EXIT_ERR, "cannot create %s", run_dir) end
	local cmd = "umask 077; setsid " .. q(SELF) .. " run >> " .. q(log_file) .. " 2>&1 < /dev/null & echo $! > " .. q(pid_file)
	if not run_ok(cmd) then die(EXIT_ERR, "cannot start") end
	return EXIT_OK
end

local function cmd_stop()
	local pid = pid_running()
	if pid then
		local socket = require("socket")
		local stopped = false
		-- The loop runs in its own session (setsid): signal the whole group, so a dune-live it started goes too.
		for _, sig in ipairs({ "TERM", "KILL" }) do
			run_ok("kill -" .. sig .. " -- -" .. pid .. " 2>/dev/null || kill -" .. sig .. " " .. pid .. " 2>/dev/null")
			for _ = 1, STOP_WAIT_SECONDS * 10 do
				if not alive(pid) then stopped = true; break end
				socket.sleep(0.1)
			end
			if stopped then break end
		end
		if not stopped then die(EXIT_ERR, "idle throttle (pid %s) did not stop", pid) end
		local f = io.open(pid_file, "w"); if f then f:close() end
	end
	local ok, err = restore()
	if not ok then die(EXIT_ERR, "could not restore the active frame rate: %s", err) end
	return EXIT_OK
end

local action = arg[1]
if action == "-h" or action == "--help" then io.stdout:write(USAGE); os.exit(EXIT_OK) end
if action == "--about" then
	local map = { x64 = "x86_64", arm64 = "aarch64" }
	io.stdout:write(string.format("%s %s: lowers the map server's frame rate while nobody is connected (%s %s)\n", NAME, VERSION,
		(jit.os or "unknown"):lower(), map[jit.arch] or jit.arch))
	os.exit(EXIT_OK)
end
if action == "start" or action == "stop" or action == "status" or action == "run" then
	if state_dir == "" then die(EXIT_ERR, "set DUNE_STATE_DIR") end
end
if action == "start" then os.exit(cmd_start())
elseif action == "stop" then os.exit(cmd_stop())
elseif action == "status" then os.exit(pid_running() and EXIT_OK or EXIT_ERR)
elseif action == "run" then
	local max, virtual
	local i = 2
	while arg[i] do
		local v = arg[i + 1]
		if arg[i] == "--polls" then
			max = tonumber(v or "")
			if not max or max < 1 or max ~= math.floor(max) then die(EXIT_USAGE, "--polls needs a whole number >= 1") end
		elseif arg[i] == "--virtual-clock" then
			virtual = tonumber(v or "")
			if not virtual or virtual < 0 or virtual ~= math.floor(virtual) then die(EXIT_USAGE, "--virtual-clock needs whole seconds >= 0") end
		else die(EXIT_USAGE, "unknown option %s (see --help)", arg[i]) end
		i = i + 2
	end
	os.exit(cmd_run(max, virtual))
else
	io.stderr:write(USAGE)
	os.exit(EXIT_USAGE)
end
