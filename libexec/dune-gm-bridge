#!/usr/bin/env luajit
-- dune-gm-bridge: in-game chat commands for trusted players. Consumes a copy of every chat message from the game
-- broker's chat.intercept exchange (own exclusive queue gm.bridge.chat, bound with #, so chat itself is unaffected),
-- and runs `&command args` from players the operator listed in $DUNE_CONFIG_DIR/gm_bridge.conf through dune-live,
-- whispering the result back. Identity is the broker-stamped AMQP user_id (FLS id) only. Ordinary chat is never
-- logged. Logic lives in lib/gm_bridge.lua (pure) and lib/amqp.lua (protocol); this file does the I/O.
-- Usage: dune-gm-bridge start|stop|status | run [--max-messages N]
local ffi = require("ffi")
ffi.cdef [[
char *realpath(const char *path, char *resolved);
void free(void *p);
int getpid(void);
]]

local NAME, VERSION = "dune-gm-bridge", "0.1.0"
local EXIT_OK, EXIT_ERR, EXIT_USAGE = 0, 1, 2
local BRIDGE_USER, QUEUE, EXCHANGE, CONSUMER_TAG = "gm_bridge", "gm.bridge.chat", "chat.intercept", "gm-bridge"
local REPLY_FROM = "GM"
local STOP_WAIT_SECONDS = 15

local function self_path()
	local r = ffi.C.realpath(arg[0], nil)
	if r == nil then return arg[0] end
	local s = ffi.string(r); ffi.C.free(r)
	return s
end
local SELF = self_path()
local DIR = SELF:match("^(.*)/[^/]*$") or "."
package.path = DIR .. "/lib/?.lua;" .. package.path
local gm = require("gm_bridge")

local USAGE = [[
Usage: dune-gm-bridge start|stop|status
       dune-gm-bridge run [--max-messages N]

In-game chat commands for trusted players, without host access. A listed player types a command in any chat channel;
the bridge runs it through dune-live and whispers the result back (sender shown as GM).

  &help                  the commands you may use
  &where                 your position (X Y Z)
  &goto <player>         move yourself to a player
  &bring <player>        move a player to you
  &say <message>         on-screen broadcast to everyone
  &timeout on|off|status the world break (no damage, sandworms or storms)
  &give <item id> [n]    put n (default 1, at most 1000) of an item into your inventory
  &kick <player>         disconnect a player

Who may use what: $DUNE_CONFIG_DIR/gm_bridge.conf, one line per player, `<character name or FLS id>: <command>...`
or `<who>: *` for every command; `#` starts a comment. No file, or nobody listed, means nobody (fail closed). The
file is read for every command, so edits apply at once. Senders are identified only by the account id the broker
stamps on each message; ordinary chat is never logged, only `&` commands (log: $DUNE_STATE_DIR/gm-bridge/).

  start / stop / status  run in the background (component interface used by dune-awakening)
  run                    foreground; --max-messages N exits after N chat messages (for tests)

Environment: DUNE_STATE_DIR, DUNE_SECRETS_DIR, DUNE_CONFIG_DIR, DUNE_RMQ_GAME_LOCAL_PORT (default 5674),
DUNE_LIVE (default: dune-live next to this tool), DUNE_GM_BRIDGE_RETRY_MAX (seconds, default 30).
]]

local function die(code, fmt, ...)
	io.stderr:write(NAME, ": ", string.format(fmt, ...), "\n")
	os.exit(code)
end
local function getenv(k, default) local v = os.getenv(k); if v == nil or v == "" then return default end; return v end
local function need(k) return getenv(k) or die(EXIT_ERR, "set %s", k) end

local function read_file(p)
	local f = io.open(p, "rb"); if not f then return nil end
	local s = f:read("*a"); f:close(); return s
end

local function run_ok(cmd)
	local a, _, c = os.execute(cmd)
	if type(a) == "number" then return a == 0 end
	return a == true and (c == nil or c == 0)
end

-- Paths ---------------------------------------------------------------------------------------------------------
local state = getenv("DUNE_STATE_DIR", "")
local run_dir = state .. "/gm-bridge"
local pid_file, log_file = run_dir .. "/pid", run_dir .. "/gm-bridge.log"

local function pid_running()
	local pid = (read_file(pid_file) or ""):match("^(%d+)")
	return pid and run_ok("kill -0 " .. pid .. " 2>/dev/null") and pid or nil
end

-- Log: private file, one line per event; command lines only, never ordinary chat.
local log_fh
local function log(fmt, ...)
	if not log_fh then
		run_ok("umask 077; mkdir -p " .. gm.shell_quote(run_dir) .. " && touch " .. gm.shell_quote(log_file) .. " && chmod 600 " .. gm.shell_quote(log_file))
		log_fh = io.open(log_file, "a")
		if not log_fh then die(EXIT_ERR, "cannot write %s", log_file) end
	end
	log_fh:write(os.date("!%Y-%m-%dT%H:%M:%SZ"), " ", string.format(fmt, ...), "\n")
	log_fh:flush()
end

-- Run dune-live with argv (each element single-quoted, so nothing is shell-interpreted); returns ok, output.
local LIVE = getenv("DUNE_LIVE", DIR .. "/dune-live")
local function live(args)
	local argv = { LIVE }
	for _, a in ipairs(args) do argv[#argv + 1] = a end
	local p = io.popen(gm.command_line(argv) .. " 2>&1 </dev/null; printf '\\n%d' $?")
	local out = p:read("*a"); p:close()
	local body, code = out:match("^(.*)\n(%d+)$")
	return code == "0", (body or out):gsub("%s+$", "")
end

-- A short reason from dune-live's output: its last line, without the tool's name prefix.
local function reason(out)
	local last = out:match("([^\n]*)$") or ""
	return (last:gsub("^dune%-live: ", "")):sub(1, 200)
end

local function reply(name, text)
	local ok, out = live({ "character", "whisper", name, text, "--from", REPLY_FROM })
	if not ok then log("reply to %s failed: %s", name, reason(out)) end
end

-- One chat delivery. Everything that is not an `&` command from a stamped sender is dropped without a trace.
local function handle(d)
	local m = gm.parse_delivery(d)
	if not m then return end
	local cmd = gm.parse_command(m.text)
	if not cmd then return end
	local ok, name = live({ "character", "whois", m.sender_fls })
	name = ok and name:match("^([^\n]+)") or nil
	if not name then log("%s", gm.log_line(m.sender_fls, nil, m.text, "unknown account")); return end
	local policy_text = read_file(getenv("DUNE_CONFIG_DIR", "") .. "/gm_bridge.conf")
	local policy, errors = gm.parse_policy(policy_text)
	for _, e in ipairs(errors) do log("gm_bridge.conf %s", e) end
	if not gm.authorize(policy, m.sender_fls, name, cmd.name) then
		log("%s", gm.log_line(m.sender_fls, name, m.text, "denied"))
		reply(name, gm.NOT_ALLOWED)
		return
	end
	log("%s", gm.log_line(m.sender_fls, name, m.text, "allowed"))
	local plan = gm.plan(cmd, { fls = m.sender_fls, name = name, origin = m.origin }, policy)
	local answer = plan.reply
	for _, argv in ipairs(plan.actions) do
		local aok, out = live(argv)
		if not aok then answer = "failed: " .. reason(out); log("  failed: %s", reason(out)); break end
	end
	reply(name, answer)
end

-- Connect, bind and consume until the connection ends or max deliveries are seen. Returns seen count, error.
local function session(max, seen)
	local amqp, tcp = require("amqp"), require("amqp_tcp")
	local password = (read_file(need("DUNE_SECRETS_DIR") .. "/gm_bridge_rmq_password") or ""):match("^(%S+)")
	if not password then return seen, "no bridge password yet (the game broker creates it)" end
	local t, err = tcp.connect("127.0.0.1", tonumber(getenv("DUNE_RMQ_GAME_LOCAL_PORT", "5674")), 10)
	if not t then return seen, err end
	local conn; conn, err = amqp.handshake(t, { user = BRIDGE_USER, password = password, product = NAME })
	if not conn then t:close(); return seen, err end
	local ok
	ok, err = conn:declare_queue(QUEUE, { exclusive = true, auto_delete = true })
	if ok then ok, err = conn:bind_queue(QUEUE, EXCHANGE, "#") end
	if ok then ok, err = conn:consume(QUEUE, CONSUMER_TAG, { no_ack = true, exclusive = true }) end
	if not ok then t:close(); return seen, err end
	t:settimeout(nil)
	log("listening on %s", EXCHANGE)
	while not max or seen < max do
		local d; d, err = conn:next_delivery()
		if not d then t:close(); return seen, err end
		seen = seen + 1
		local hok, herr = pcall(handle, d)
		if not hok then log("error handling a command: %s", tostring(herr)) end
	end
	conn:close(); t:close()
	return seen
end

-- Foreground loop with capped exponential backoff between sessions.
local function cmd_run(max)
	local socket = require("socket")
	local retry_max = tonumber(getenv("DUNE_GM_BRIDGE_RETRY_MAX", "30")) or 30
	local delay, seen = 0.5, 0
	log("started (pid %d)", ffi.C.getpid())
	while true do
		local err
		seen, err = session(max, seen)
		if max and seen >= max then log("stopping after %d messages", seen); return EXIT_OK end
		delay = math.min(delay, retry_max)
		log("broker: %s; retrying in %gs", tostring(err), delay)
		socket.sleep(delay)
		delay = delay * 2
	end
end

local function cmd_start()
	if pid_running() then return EXIT_OK end
	run_ok("umask 077; mkdir -p " .. gm.shell_quote(run_dir))
	local cmd = "umask 077; setsid " .. gm.shell_quote(SELF) .. " run >> " .. gm.shell_quote(log_file) ..
		" 2>&1 < /dev/null & echo $! > " .. gm.shell_quote(pid_file)
	if not run_ok(cmd) then die(EXIT_ERR, "cannot start") end
	return EXIT_OK
end

local function cmd_stop()
	local pid = pid_running()
	if not pid then return EXIT_OK end
	local socket = require("socket")
	for _, sig in ipairs({ "TERM", "KILL" }) do
		run_ok("kill -" .. sig .. " " .. pid .. " 2>/dev/null")
		for _ = 1, STOP_WAIT_SECONDS * 10 do
			if not run_ok("kill -0 " .. pid .. " 2>/dev/null") then
				local f = io.open(pid_file, "w"); if f then f:close() end
				return EXIT_OK
			end
			socket.sleep(0.1)
		end
	end
	die(EXIT_ERR, "bridge (pid %s) did not stop", pid)
end

local action = arg[1]
if action == "-h" or action == "--help" then io.stdout:write(USAGE); os.exit(EXIT_OK) end
if action == "--about" then
	local map = { x64 = "x86_64", arm64 = "aarch64" }
	io.stdout:write(string.format("%s %s: in-game chat commands for trusted players (%s %s)\n", NAME, VERSION,
		(jit.os or "unknown"):lower(), map[jit.arch] or jit.arch))
	os.exit(EXIT_OK)
end
if action == "start" or action == "stop" or action == "status" or action == "run" then need("DUNE_STATE_DIR") end
if action == "start" then os.exit(cmd_start())
elseif action == "stop" then os.exit(cmd_stop())
elseif action == "status" then os.exit(pid_running() and EXIT_OK or EXIT_ERR)
elseif action == "run" then
	local max
	local i = 2
	while arg[i] do
		if arg[i] == "--max-messages" then
			max = tonumber(arg[i + 1] or "")
			if not max or max < 1 or max ~= math.floor(max) then die(EXIT_USAGE, "--max-messages needs a whole number >= 1") end
			i = i + 2
		else die(EXIT_USAGE, "unknown option %s (see --help)", arg[i]) end
	end
	os.exit(cmd_run(max))
else
	io.stderr:write(USAGE)
	os.exit(EXIT_USAGE)
end
