#!/usr/bin/env bash
# Create one partition (dimension 0) per map given (default: Survival_1 alone) with Funcom's own add_partition_unique
# helper, label new ones with update_partition_labels, and print "<map> <partition_id>" per map, in the order given
# (the id is that map server's -PartitionIndex). Idempotent. Funcom's basic_survival_1 preset would add Survival_1
# dimensions 1-3 too, which a one-server world cannot serve. Only maps in data/maps.tsv are accepted.
# Usage: dune-world-partitions [MAP...]
set -u
: "${DUNE_SECRETS_DIR:?set DUNE_SECRETS_DIR}"
: "${DUNE_STATE_DIR:?set DUNE_STATE_DIR}"
DUNE_PG_PORT=${DUNE_PG_PORT:-15431}
die() { printf 'dune-world-partitions: %s\n' "$*" >&2; exit 1; }
maps_table="$(dirname -- "$0")/../data/maps.tsv"
[ $# -gt 0 ] || set -- Survival_1
for m in "$@"; do
	[[ "$m" =~ ^[A-Za-z0-9_]+$ ]] || die "invalid map name: $m"
	awk -F'\t' -v m="$m" '!/^#/ && $1 == m { found = 1 } END { exit !found }' "$maps_table" 2>/dev/null || die "unknown map $m (not in $maps_table)"
done
keywords="$DUNE_STATE_DIR/db-utils/DuneSandbox/Config/perforce-keywords.json"
[ -s "$keywords" ] || die "no $keywords; run dune-db-setup first"
db=$(jq -r '.path' "$keywords" | sed -E 's#.*//seabass/([^/]+)/.*#\1#; s/[-.]/_/g; s/^/dune_/')
definition='{"box": {"max_x": 1, "max_y": 1, "min_x": 0, "min_y": 0}, "type": "box2d_array"}'
# Map names are checked above ([A-Za-z0-9_] only), so they are safe inside SQL string literals.
i=0; values=""
for m in "$@"; do i=$((i + 1)); values+="${values:+,}('$m',$i)"; done
# Labels are set, and partition watchers notified, only when a row was added: the heal timer runs this every few
# minutes against the live world.
PGPASSWORD=$(cat "$DUNE_SECRETS_DIR/postgres_dune_password") psql -X -A -t -q -v ON_ERROR_STOP=1 \
	-h 127.0.0.1 -p "$DUNE_PG_PORT" -U dune -d "$db" <<SQL || die "partition setup failed"
set search_path = dune, public;
do \$\$
declare added int := 0; m text;
begin
	foreach m in array array[$(printf "'%s'," "$@" | sed 's/,$//')] loop
		if add_partition_unique(m, '$definition'::jsonb, 0) is not null then added := added + 1; end if;
	end loop;
	if added > 0 then
		perform update_partition_labels(false);
		notify world_partition_update;
	end if;
end
\$\$;
select w.map || ' ' || p.partition_id from (values $values) as w(map, ord)
	join world_partition p on p.map = w.map and p.dimension_index = 0
	order by w.ord;
SQL
