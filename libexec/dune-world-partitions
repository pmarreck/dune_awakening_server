#!/usr/bin/env bash
# Create the world's single Survival_1 partition (dimension 0) with Funcom's own add_partition_unique helper,
# label it with update_partition_labels, and print its partition_id (the game server's -PartitionIndex).
# Funcom's basic_survival_1 preset would add dimensions 1-3 too, which a one-server world cannot serve.
set -u
: "${DUNE_SECRETS_DIR:?set DUNE_SECRETS_DIR}"
: "${DUNE_STATE_DIR:?set DUNE_STATE_DIR}"
DUNE_PG_PORT=${DUNE_PG_PORT:-15431}
die() { printf 'dune-world-partitions: %s\n' "$*" >&2; exit 1; }
keywords="$DUNE_STATE_DIR/db-utils/DuneSandbox/Config/perforce-keywords.json"
[ -s "$keywords" ] || die "no $keywords; run dune-db-setup first"
db=$(jq -r '.path' "$keywords" | sed -E 's#.*//seabass/([^/]+)/.*#\1#; s/[-.]/_/g; s/^/dune_/')
definition='{"box": {"max_x": 1, "max_y": 1, "min_x": 0, "min_y": 0}, "type": "box2d_array"}'
PGPASSWORD=$(cat "$DUNE_SECRETS_DIR/postgres_dune_password") psql -X -A -t -q -v ON_ERROR_STOP=1 \
	-h 127.0.0.1 -p "$DUNE_PG_PORT" -U dune -d "$db" > /dev/null <<SQL || die "partition setup failed"
set search_path = dune, public;
select add_partition_unique('Survival_1', '$definition'::jsonb, 0);
select update_partition_labels(false);
SQL
PGPASSWORD=$(cat "$DUNE_SECRETS_DIR/postgres_dune_password") psql -X -A -t -h 127.0.0.1 -p "$DUNE_PG_PORT" -U dune -d "$db" \
	-c "select partition_id from dune.world_partition where map = 'Survival_1' and dimension_index = 0" || die "lookup failed"
