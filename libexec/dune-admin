#!/usr/bin/env bash
# Live-world admin commands through Funcom's server-command channel (UDuneServerCommandSubsystem). A command is a JSON
# object {"ServerCommand": NAME, "PlayerId": <Funcom id or *>, ...named arguments}, wrapped in the Version 2 envelope
# {"Version":2,"AuthToken":…,"MessageContent":"<inner json>"} and published by the game RabbitMQ node itself
# (rabbitmqctl eval) into exchange heartbeats with routing key notifications, as user fls / app fls_backend, which
# is what the map server accepts. The envelope goes through a 0600 file, so the token never appears on a command line.
# Contract adapted from Red-Blink/dune-awakening-selfhost-docker (MIT) via DASH.
set -u
NAME=dune-admin VERSION=0.1.0
: "${HOME:=$(cd ~ 2>/dev/null && pwd)}"
DUNE_STATE_DIR=${DUNE_STATE_DIR:-$HOME/.local/share/dune_awakening_server/runtime}
DUNE_SECRETS_DIR=${DUNE_SECRETS_DIR:-$DUNE_STATE_DIR/secrets}
DUNE_PG_PORT=${DUNE_PG_PORT:-15431}
DUNE_COMPONENTS_DIR=${DUNE_COMPONENTS_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}

usage() {
	cat <<EOF
Usage: $NAME [options] <command> [args]

Send commands to the running Dune world (map server must be up; commands for a player need them online).

Commands:
  players                         Characters with online state (read-only)
  partitions                      World partitions: id, label, map (read-only)
  where <player>                  A character's partition, map and X Y Z (read-only)
  move <player> X Y Z [--partition LABEL|ID]
                                  Move an OFFLINE character (Funcom's admin_move_offline_player_to_partition),
                                  after a backup; the partition defaults to their current one. Rescues a stuck player
  whisper <player> <message> [--from NAME]
                                  Private chat line to an online player (chat.whispers to their own queue; the
                                  sender shown is NAME, default Admin)
  kick <player> | --all           Disconnect a player, or everyone online
  teleport <player> X Y Z [YAW]   Move an online player (world coordinates, centimetres)
  say <message> [--duration S]    On-screen broadcast to everyone (default 20 s)
  worm <player>                   ServerExec "SandwormTargetPlayer <player>" in that player's context: sends a worm
                                  that is already near them at them (experimental; needs them online on open sand)
  water <player> AMOUNT           Fill the player's water containers (UpdateAllWaterFillables)
  xp <player> AMOUNT [CATEGORY]   Award XP; CATEGORY is Combat (default), Crafting, Gathering, Exploration or Sabotage
  exec <console command...>       World-level engine console command or variable via ServerExec, e.g.
                                  \`exec t.MaxFPS 5\` (output is not returned; watch the server log)
  timeout on|off|status           Break for everyone without logging off: turns off all damage, sandworms,
                                  sandstorms and Coriolis storms (each verified in the server log), announces it,
                                  and restores the previous values on `off`. Aliases for `on`: bio-break,
                                  call-timeout, safety-first
  raw <ServerCommand> [--player P] [Key=value[:int|:float]...]
                                  Any other server command, for exploration (see the server log for the result)

Options: --json (players, partitions, where), --about, -h/--help. A <player> is a character name.
Environment: DUNE_STATE_DIR, DUNE_SECRETS_DIR, DUNE_PG_PORT, DUNE_DB_NAME (default: the newest dune_sb_* database).
EOF
}
die() { printf '%s: %s\n' "$NAME" "$1" >&2; exit "${2:-1}"; }
usage_error() { die "$1 (see --help)" 2; }

sql() {
	local db=${DUNE_DB_NAME:-}
	PGPASSWORD=$(cat "$DUNE_SECRETS_DIR/postgres_admin_password" 2>/dev/null) || die "no postgres admin password in $DUNE_SECRETS_DIR"
	export PGPASSWORD
	if [ -z "$db" ]; then
		db=$(psql -X -A -t -q -h 127.0.0.1 -p "$DUNE_PG_PORT" -U postgres -d postgres \
			-c "select datname from pg_database where datname like 'dune\_sb\_%' order by 1 desc limit 1" 2>/dev/null) || die "cannot reach postgres"
		[ -n "$db" ] || die "no dune_sb_* database found"
	fi
	# Funcom's procedures name their tables without a schema, as the game server's own connections do.
	PGOPTIONS="-c search_path=dune,public" psql -X -A -t -q -v ON_ERROR_STOP=1 -h 127.0.0.1 -p "$DUNE_PG_PORT" -U postgres -d "$db" "$@"
}

# Character name -> Funcom id (the PlayerId server commands expect). Name passed as a psql variable, never spliced.
funcom_id() {
	local id
	id=$(sql -v name="$1" -f - <<<"select a.funcom_id from dune.player_state ps join dune.accounts a on a.id = ps.account_id where ps.character_name = :'name' limit 1;") ||
		die "database lookup failed"
	[ -n "$id" ] || die "no character named $1"
	printf '%s' "$id"
}

# Character name -> FLS id (accounts.user): what Funcom's procedures and the per-player chat queues use.
fls_id() {
	local id
	id=$(sql -v name="$1" -f - <<<"select a.\"user\" from dune.player_state ps join dune.accounts a on a.id = ps.account_id where ps.character_name = :'name' limit 1;") ||
		die "database lookup failed"
	[ -n "$id" ] || die "no character named $1"
	[[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "unexpected FLS id format for $1"
	printf '%s' "$id"
}

# One character's location as JSON. Reads actors directly: Funcom's admin_get_character_details is broken in 1.5.
where_json() {
	sql -v name="$1" -f - <<<"select json_build_object('name', ps.character_name, 'online', ps.online_status::text <> 'Offline',
		'partition', wp.label, 'partition_id', a.partition_id, 'map', a.map,
		'x', ((a.transform).location).x, 'y', ((a.transform).location).y, 'z', ((a.transform).location).z)
	from dune.player_state ps join dune.actors a on a.id = ps.player_pawn_id left join dune.world_partition wp on wp.partition_id = a.partition_id
	where ps.character_name = :'name' limit 1;"
}

# Whisper: DASH's confirmed route (docs/private-chat-replies.md). A TextChat courier carrying a Whispers message goes to
# exchange chat.whispers with the player's FLS id as routing key, bound for the call to their own <FLS id>_queue. The
# queue exists only while they are online. A binding the game already made is left alone; ours is removed afterwards.
whisper() {
	local player=$1 from=$2 msg=$3 fls inner body out
	fls=$(fls_id "$player") || exit 1
	inner=$(jq -cn --arg id "$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')" --arg from "$from" --arg to "$player" --arg m "$msg" \
		--arg ts "$(date -u +%Y.%m.%d-%H.%M.%S)" \
		'{m_Id: $id, m_ChannelType: "Whispers", m_bUseSpoofedUserName: true,
		  m_SpoofedUserNameFrom: {m_TableId: "", m_Key: "", m_UnlocalizedName: $from}, m_FuncomIdFrom: "ADMIN#00001",
		  m_UserNameTo: $to, m_Message: {m_UnlocalizedMessage: $m, m_LocalizedMessage: {m_TableId: "", m_Key: "", m_FormatArgs: []}},
		  m_TimeStamp: $ts, m_OriginLocation: {X: 0.0, Y: 0.0, Z: 0.0}, m_HasSeenMessage: false}')
	body=$(mktemp "$DUNE_SECRETS_DIR/.XXXXXX.chat.json") || die "cannot create a private temp file"
	jq -cn --arg c "$inner" '{content: $c, Type: "TextChat"}' > "$body" || { rm -f -- "$body"; die "cannot build whisper"; }
	out=$("$DUNE_COMPONENTS_DIR/dune-rabbitmq" ctl game eval \
		"XName = rabbit_misc:r(<<\"/\">>, exchange, <<\"chat.whispers\">>), QName = rabbit_misc:r(<<\"/\">>, queue, <<\"${fls}_queue\">>), case rabbit_amqqueue:lookup(QName) of {error, not_found} -> io:format(\"whisper=noqueue~n\"); {ok, _} -> B = {binding, XName, <<\"$fls\">>, QName, []}, Added = case rabbit_binding:exists(B) of true -> false; _ -> ok = rabbit_binding:add(B, <<\"dune-admin\">>), true end, {ok, Body} = file:read_file(\"$body\"), X = rabbit_exchange:lookup_or_die(XName), MsgId = list_to_binary(\"dune-admin-\" ++ integer_to_list(erlang:system_time(millisecond))), P = {list_to_atom(\"P_basic\"), <<\"Content\">>, undefined, [], 1, undefined, undefined, undefined, undefined, MsgId, undefined, <<\"text_chat\">>, undefined, undefined, undefined}, Content = rabbit_basic:build_content(P, Body), {ok, Msg} = rabbit_basic:message(XName, <<\"$fls\">>, Content), Result = rabbit_queue_type:publish_at_most_once(X, Msg), case Added of true -> rabbit_binding:remove(B, <<\"dune-admin\">>); false -> ok end, io:format(\"whisper=ok~npublish=~p~n\", [Result]) end." 2>&1)
	rm -f -- "$body"
	[[ "$out" == *whisper=noqueue* ]] && die "$player is not online (no chat queue ${fls}_queue)"
	[[ "$out" == *whisper=ok* && "$out" == *publish=ok* ]] || die "whisper publish failed (is the world up?): $(printf '%s' "$out" | tail -2)"
	echo "whispered to $player" >&2
}

# Move an offline character: resolve the target partition, refuse online players (Funcom's is_player_offline, which
# also treats a player whose server is gone as offline), back up, then call Funcom's procedure.
move() {
	local player=$1 x=$2 y=$3 z=$4 partition=$5 fls pid label out offline
	fls=$(fls_id "$player") || exit 1
	if [ -z "$partition" ]; then
		pid=$(sql -v fls="$fls" -f - <<<"select a.partition_id from dune.player_state ps join dune.accounts ac on ac.id = ps.account_id join dune.actors a on a.id = ps.player_pawn_id where ac.\"user\" = :'fls' limit 1;") || die "database lookup failed"
		[ -n "$pid" ] || die "$player has no body in the world yet; give --partition"
	else
		pid=$(sql -v p="$partition" -f - <<<"select partition_id from dune.world_partition where label = :'p' or partition_id::text = :'p' order by (label = :'p') desc limit 1;") || die "database lookup failed"
		[ -n "$pid" ] || die "no partition $partition (see: dune-world admin partitions)"
	fi
	label=$(sql -c "select coalesce(label, partition_id::text) from dune.world_partition where partition_id = $pid") || die "database lookup failed"
	offline=$(sql -v fls="$fls" -f - 2>&1 <<<"select dune.is_player_offline(:'fls');") || die "database lookup failed: $(printf '%s' "$offline" | sed -n 's/^.*ERROR: *//p' | head -1)"
	[ "$offline" = t ] ||
		die "$player is online; move works only for offline players (use teleport while they are online)"
	out=$("$DUNE_COMPONENTS_DIR/dune-backup" create --label pre-move 2>&1) || die "backup before the move failed, nothing moved: $(printf '%s' "$out" | tail -1)"
	out=$(sql -v fls="$fls" -f - 2>&1 <<<"select dune.admin_move_offline_player_to_partition(:'fls', $pid, row($x, $y, $z)::dune.vector);") || {
		[[ "$out" == *"Player must be Offline"* ]] && die "$player came online; nothing moved"
		die "move failed: $(printf '%s' "$out" | sed -n 's/^.*ERROR: *//p' | head -1)"
	}
	echo "moved $player to $label $x $y $z (backup taken first)"
}

# Publish one inner command object (JSON text) through the game broker.
publish() {
	local inner=$1 token body out
	token=$(tr -d '\r\n' < "$DUNE_SECRETS_DIR/server_commands_token" 2>/dev/null) && [ -n "$token" ] ||
		die "no server command token in $DUNE_SECRETS_DIR (start the world once with command support)"
	body=$(mktemp "$DUNE_SECRETS_DIR/.XXXXXX.cmd.json") || die "cannot create a private temp file"
	chmod 600 "$body"
	jq -cn --arg t "$token" --arg m "$inner" '{Version: 2, AuthToken: $t, MessageContent: $m}' > "$body" || { rm -f -- "$body"; die "cannot build envelope"; }
	out=$("$DUNE_COMPONENTS_DIR/dune-rabbitmq" ctl game eval \
		"{ok, Outer} = file:read_file(\"$body\"), XName = rabbit_misc:r(<<\"/\">>, exchange, <<\"heartbeats\">>), X = rabbit_exchange:lookup_or_die(XName), MsgId = list_to_binary(\"dune-admin-\" ++ integer_to_list(erlang:system_time(millisecond))), P = {list_to_atom(\"P_basic\"), <<\"Content\">>, undefined, [], undefined, undefined, undefined, undefined, undefined, MsgId, undefined, undefined, <<\"fls\">>, <<\"fls_backend\">>, undefined}, Content = rabbit_basic:build_content(P, Outer), {ok, Msg} = rabbit_basic:message(XName, <<\"notifications\">>, Content), Result = rabbit_queue_type:publish_at_most_once(X, Msg), io:format(\"publish=~p~n\", [Result])." 2>&1)
	rm -f -- "$body"
	[[ "$out" == *publish=ok* ]] || die "publish failed (is the world up?): $(printf '%s' "$out" | tail -2)"
	printf 'sent %s\n' "$(jq -r .ServerCommand <<<"$inner")" >&2
}

number() { [[ "$1" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || usage_error "not a number: $1"; }

# Timeout: world-level console variables that make play safe for a break. Values are read back from the map
# server's log, where it echoes `Log: <cvar> = "<value>"` for every ServerExec query, so each change is verified.
DUNE_SERVER_LOG=${DUNE_SERVER_LOG:-$DUNE_STATE_DIR/server/server-console.log}
DUNE_TIMEOUT_WAIT=${DUNE_TIMEOUT_WAIT:-10}
TIMEOUT_STATE="$DUNE_STATE_DIR/timeout.state"
TIMEOUT_CVARS=(Dac.DamageEnabled sandworm.dune.Enabled Sandstorm.Enabled Coriolis.Enabled)
normalize() { case "$1" in false|0) echo 0 ;; true|1) echo 1 ;; *) echo "$1" ;; esac; }

# Ask the server for a console variable's value; print it (normalized) once the server logs it.
cvar_get() {
	local name=$1 start line deadline
	start=$(stat -c %s "$DUNE_SERVER_LOG" 2>/dev/null || echo 0)
	publish "$(jq -cn --arg e "$name" '{ServerCommand: "ServerExec", Exec: $e}')" 2>/dev/null || return 1
	deadline=$(( $(date +%s) + DUNE_TIMEOUT_WAIT ))
	while [ "$(date +%s)" -le "$deadline" ]; do
		line=$(tail -c +"$((start + 1))" "$DUNE_SERVER_LOG" 2>/dev/null | grep -a -F "Log: $name = " | tail -1)
		[ -n "$line" ] && { normalize "$(sed -n 's/.*Log: [^ ]* = "\([^"]*\)".*/\1/p' <<<"$line")"; return 0; }
		sleep 0.2
	done
	return 1
}

cvar_set_verified() {
	publish "$(jq -cn --arg e "$1 $2" '{ServerCommand: "ServerExec", Exec: $e}')" 2>/dev/null || die "could not send $1"
	[ "$(cvar_get "$1")" = "$(normalize "$2")" ] || die "could not verify $1 = $2 in the server log ($DUNE_SERVER_LOG)"
}

broadcast() {
	publish "$(jq -cn --arg m "$1" '{ServerCommand: "ServiceBroadcast", BroadcastType: "Generic",
		BroadcastPayload: {BroadcastDuration: 15, LocalizedText: [{Key: "en", Title: "", Body: $m}, {Key: "en-US", Title: "", Body: $m}]}}')" 2>/dev/null
}

timeout_on() {
	local c v
	if [ ! -s "$TIMEOUT_STATE" ]; then
		local saved=""
		for c in "${TIMEOUT_CVARS[@]}"; do
			v=$(cvar_get "$c") || die "could not verify the current value of $c (is the map server up? log: $DUNE_SERVER_LOG)"
			saved+="$c=$v"$'\n'
		done
		(umask 077; mkdir -p "${TIMEOUT_STATE%/*}" && printf '%s' "$saved" > "$TIMEOUT_STATE") || die "cannot write $TIMEOUT_STATE"
	fi
	for c in "${TIMEOUT_CVARS[@]}"; do cvar_set_verified "$c" 0; done
	broadcast "Timeout: no damage, no sandworms, no storms. Take your break."
	echo "timeout on: damage, sandworms, sandstorms and Coriolis storms are off (dune-world admin timeout off to resume)"
}

timeout_off() {
	local c v
	[ -s "$TIMEOUT_STATE" ] || { echo "timeout is not on"; return 0; }
	while IFS='=' read -r c v; do [ -n "$c" ] && cvar_set_verified "$c" "$v"; done < "$TIMEOUT_STATE"
	rm -f -- "$TIMEOUT_STATE"
	broadcast "Timeout over: the desert is dangerous again."
	echo "timeout off: previous values restored"
}

timeout_status() {
	local v
	v=$(cvar_get Dac.DamageEnabled) || die "could not read Dac.DamageEnabled from the server log"
	if [ "$v" = 0 ]; then echo "timeout on (damage is off)"; else echo "timeout off"; fi
}

json=false args=()
for a in "$@"; do
	case "$a" in
		-h|--help) usage; exit 0 ;;
		--about) printf '%s %s: Dune world admin commands via the server-command channel (%s %s)\n' "$NAME" "$VERSION" "$(uname -s | tr '[:upper:]' '[:lower:]')" "$(uname -m)"; exit 0 ;;
		--json) json=true ;;
		*) args+=("$a") ;;
	esac
done
set -- "${args[@]+"${args[@]}"}"
cmd=${1:-}; [ $# -gt 0 ] && shift

case "$cmd" in
	players)
		rows=$(sql -c "select coalesce(json_agg(json_build_object('name', ps.character_name, 'online', ps.online_status::text <> 'Offline') order by ps.character_name), '[]') from dune.player_state ps") || die "database lookup failed"
		if $json; then printf '%s\n' "$rows"; else jq -r '.[] | (if .online then "● " else "○ " end) + .name' <<<"$rows"; fi ;;
	partitions)
		rows=$(sql -c "select coalesce(json_agg(json_build_object('id', partition_id, 'label', label, 'map', map, 'dimension', dimension_index) order by partition_id), '[]') from dune.world_partition") ||
			die "database lookup failed"
		if $json; then printf '%s\n' "$rows"; else jq -r '.[] | "\(.id)\t\(.label // "-")\t\(.map)"' <<<"$rows"; fi ;;
	where)
		[ $# -eq 1 ] || usage_error "where needs a player"
		row=$(where_json "$1") || die "database lookup failed"
		[ -n "$row" ] || die "no character named $1 with a body in the world"
		if $json; then printf '%s\n' "$row"; else jq -r '"\(.name) (\(if .online then "online" else "offline" end)): \(.partition // .partition_id) \(.map) \(.x) \(.y) \(.z)"' <<<"$row"; fi ;;
	move)
		partition="" pos=()
		while [ $# -gt 0 ]; do
			case "$1" in --partition) [ $# -ge 2 ] || usage_error "--partition needs a label or id"; partition=$2; shift ;; *) pos+=("$1") ;; esac
			shift
		done
		[ ${#pos[@]} -eq 4 ] || usage_error "move needs <player> X Y Z [--partition LABEL|ID]"
		for n in "${pos[@]:1}"; do number "$n"; done
		move "${pos[@]}" "$partition" ;;
	whisper)
		from=Admin msg="" player=""
		while [ $# -gt 0 ]; do
			case "$1" in
				--from) [ $# -ge 2 ] || usage_error "--from needs a name"; from=$2; shift ;;
				*) if [ -z "$player" ]; then player=$1; else msg=${msg:+$msg }$1; fi ;;
			esac
			shift
		done
		[ -n "$player" ] && [ -n "$msg" ] || usage_error "whisper needs <player> <message>"
		whisper "$player" "$from" "$msg" ;;
	kick)
		[ $# -eq 1 ] || usage_error "kick needs a player or --all"
		if [ "$1" = --all ]; then id='*'; else id=$(funcom_id "$1") || exit 1; fi
		publish "$(jq -cn --arg p "$id" '{ServerCommand: "KickPlayer", PlayerId: $p}')" ;;
	teleport)
		[ $# -eq 4 ] || [ $# -eq 5 ] || usage_error "teleport needs <player> X Y Z [YAW]"
		for n in "${@:2}"; do number "$n"; done
		id=$(funcom_id "$1") || exit 1
		publish "$(jq -cn --arg p "$id" --argjson x "$2" --argjson y "$3" --argjson z "$4" --argjson yaw "${5:-null}" \
			'{ServerCommand: "TeleportTo", PlayerId: $p, X: $x, Y: $y, Z: $z} + (if $yaw == null then {} else {Yaw: $yaw} end)')" ;;
	say)
		msg="" duration=20
		while [ $# -gt 0 ]; do
			case "$1" in --duration) [ $# -ge 2 ] || usage_error "--duration needs seconds"; duration=$2; shift ;; *) msg=${msg:+$msg }$1 ;; esac
			shift
		done
		[ -n "$msg" ] || usage_error "say needs a message"
		[[ "$duration" =~ ^[0-9]+$ ]] || usage_error "--duration needs whole seconds"
		publish "$(jq -cn --arg m "$msg" --argjson d "$duration" '{ServerCommand: "ServiceBroadcast", BroadcastType: "Generic",
			BroadcastPayload: {BroadcastDuration: $d, LocalizedText: [{Key: "en", Title: "", Body: $m}, {Key: "en-US", Title: "", Body: $m}]}}')" ;;
	worm)
		[ $# -eq 1 ] || usage_error "worm needs a player"
		id=$(funcom_id "$1") || exit 1
		publish "$(jq -cn --arg p "$id" --arg e "SandwormTargetPlayer $1" '{ServerCommand: "ServerExec", PlayerId: $p, Exec: $e}')" ;;
	exec)
		[ $# -ge 1 ] || usage_error "exec needs a console command"
		publish "$(jq -cn --arg e "$*" '{ServerCommand: "ServerExec", Exec: $e}')" ;;
	water)
		[ $# -eq 2 ] && [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ] || usage_error "water needs <player> and a positive whole AMOUNT"
		id=$(funcom_id "$1") || exit 1
		publish "$(jq -cn --arg p "$id" --argjson w "$2" '{ServerCommand: "UpdateAllWaterFillables", PlayerId: $p, WaterAmount: $w}')" ;;
	xp)
		{ [ $# -eq 2 ] || [ $# -eq 3 ]; } && [[ "$2" =~ ^[0-9]+$ ]] || usage_error "xp needs <player> AMOUNT [CATEGORY]"
		case "${3:-Combat}" in Combat|Crafting|Gathering|Exploration|Sabotage) ;; *) usage_error "unknown XP category ${3}" ;; esac
		id=$(funcom_id "$1") || exit 1
		publish "$(jq -cn --arg p "$id" --argjson x "$2" --arg c "${3:-Combat}" '{ServerCommand: "AwardXP", PlayerId: $p, Experience: $x, Category: $c}')" ;;
	timeout)
		case "${1:-}" in on) timeout_on ;; off) timeout_off ;; status|"") timeout_status ;; *) usage_error "timeout takes on, off or status" ;; esac ;;
	bio-break|call-timeout|safety-first) timeout_on ;;
	raw)
		[ $# -ge 1 ] || usage_error "raw needs a ServerCommand name"
		obj=$(jq -cn --arg c "$1" '{ServerCommand: $c}'); shift
		while [ $# -gt 0 ]; do
			case "$1" in
				--player) [ $# -ge 2 ] || usage_error "--player needs a name"; id=$(funcom_id "$2") || exit 1; obj=$(jq -c --arg p "$id" '. + {PlayerId: $p}' <<<"$obj"); shift ;;
				*=*:int|*=*:float) k=${1%%=*} v=${1#*=}; v=${v%:*}; number "$v"; obj=$(jq -c --arg k "$k" --argjson v "$v" '. + {($k): $v}' <<<"$obj") ;;
				*=*) k=${1%%=*} v=${1#*=}; obj=$(jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$obj") ;;
				*) usage_error "raw arguments are Key=value[:int|:float], got $1" ;;
			esac
			shift
		done
		publish "$obj" ;;
	"") usage >&2; exit 2 ;;
	*) usage_error "unknown command $cmd" ;;
esac
