# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.envrc = direnv: PATH_add bin
	.luacheckrc = luacheck config: LuaJIT std, 200-column lines
	.mechatron-prime/targets = Mechatron Prime CI target: the hermetic check
	INTENT.md = Private two-player Linux hosting purpose and constraints
	bin/dune-awakening = The one operator command (was dune-world): start/stop/status and world/character/update/backup/init/units
	bin/short/dune = Short name for dune-awakening; .envrc adds bin/short only when no dune executable is on PATH
	build = Realize the operator shell's pinned tools ahead of the first dune-awakening run
	config.sample = operator config templates (*.sample): copy to ~/.config/dune_awakening_server and drop the suffix
	config.sample/backup.conf.sample = backup retention template: KEEP_ALL_DAYS, KEEP_WEEKLY_DAYS
	docs/acquisition.md = Steam package, FLS token, private inputs, and sizing findings from pinned DASH
	docs/admin.md = Everything about administering the world: host commands, moves, whispers, timeout, and the game's in-game GM system (AdminSetting, passwords, Admin Panel key hunt)
	docs/architecture.md = Synthesis: component graph, 1.5 version proof, native NixOS gap list
	docs/operations.md = How to run, stop, inspect the native world; files, logs, ports
	docs/payload/steam-4754530-build-25486303.sha256 = SHA-256 of official Steam server payload files, build 25486303 / image 2124138
	docs/postgres-parity.md = Every difference between Funcom igw-postgres and our nixpkgs PostgreSQL
	docs/readiness.md = impersonal evidence record of the native bring-up
	docs/research/dash-compose-wiring.md = DASH Docker Compose wiring with citations
	docs/research/funcom-appliance-wiring.md = Funcom k8s appliance wiring with citations
	docs/research/image-internals.md = Per-image internals: runtimes, binaries, configs, nixpkgs gaps
	docs/research/live-world-control.md = research: RCON/console absent; server-command subsystem over game RMQ (off by default); Director routes; chat exchanges; admin DB procs
	docs/research/version-1.5-compatibility.md = Dated evidence on 1.5 self-host package updates, client/server version lock, watch URLs
	flake.nix = Pinned DASH source and operator development shell
	libexec/dune-admin = live-world commands via Funcom server-command channel: players, say, kick, teleport, water, xp, exec (ServerExec), worm, raw
	libexec/dune-backup = Backups: pg_dump -Fc of world DBs + roles + operator config, sha256 manifest; verify = restore drill; guarded restore; prune to trash
	libexec/dune-character = LuaJIT character viewer/editor: list/show/set-intel/add-intel/set-skill-points/add-skill-points, export/validate/import via Funcom transfer procs
	libexec/dune-db-setup = Run Funcom updatedb.py against our cluster with private UserGame.ini credentials
	libexec/dune-director = Run Director natively: FLS registration, conf.d override, private log
	libexec/dune-dotnet-prepare = Native copy of Funcom musl .NET apps: patchelf interpreter + flake netcoredeps
	libexec/dune-gateway = Run Gateway (py3.12 bytecode) natively with world conf.d/gateway.ini
	libexec/dune-live = Live-world commands grouped by target: world (say, timeout, kick-all, exec, partitions, raw) and character (move, where, kick, water, xp, whisper, worm)
	libexec/dune-postgres = Init/start/stop/status of the loopback-only scram PostgreSQL 17 cluster
	libexec/dune-rabbitmq = Admin (AMQP) and game (TLS) RabbitMQ brokers with TextRouter HTTP auth, ephemeral
	libexec/dune-server = Run Survival_1 map server: symlink farm, patched binary, secret ini, memory-capped scope
	libexec/dune-textrouter = Run TextRouter natively: RMQ HTTP auth backend, DB + TLS broker, private log
	libexec/dune-units = renders systemd user units: world at boot, heal timer, daily backup+prune, weekly restore drill, daily update check
	libexec/dune-unpack = Unpack docker-archive image layers (plain/gzip, OCI whiteouts) without containers
	libexec/dune-update = Steam build staleness check (exit 0/1/3, --json) and update procedure: online guard, backup, stop, validated download, unpack with .prev, start, re-check
	libexec/dune-usersettings = Deploy User*.ini defaults + operator overrides into Saved/UserSettings
	libexec/dune-world-init = One-time world identity sh-<HostId>-<6> and join password from the FLS token
	libexec/dune-world-partitions = Create single Survival_1 partition via Funcom helper; print partition_id
	test = Runs all suites; --hermetic excludes payload-tier suites (Nix check)
	tests/integration/admin = dune-admin payloads/envelope against a fake broker; token never on argv
	tests/integration/backup = dune-backup create/list/verify/restore/prune on a throwaway cluster
	tests/integration/character-tool = Synthetic Funcom-shaped DB: config chain, feature detection, online refusal, backups
	tests/integration/live = dune-live world/character groups against a synthetic DB and fake broker/backup
	tests/integration/postgres = Lifecycle, auth, and loopback test for libexec/dune-postgres
	tests/integration/rabbitmq = Host-tier test: both brokers, TLS, HTTP auth path, fail-closed
	tests/integration/server-config = dune-server configure: private ini carries ServerCommandsAuthToken + NotificationSystem cvar, token stable, 0600
	tests/integration/units = dune-units render: unit set, quoting, exec paths, systemd-analyze verify
	tests/integration/units-verify = host tier: rendered units pass systemd-analyze verify
	tests/integration/update = dune-update check/apply against fake steamcmd and components
	tests/integration/world-cli = dune-awakening CLI: help/about/usage, symlink self-location, external address precedence, start/stop order with fake components
	tests/integration/world-cli-nix = host tier: dune-awakening from a bare env re-execs into the devShell
	tests/integration/world-init = World identity is Funcom-shaped, stable across re-init, password private
	tests/integration/world-status = status --json shape with everything down (admin page contract)
	tests/lib/ports.bash = pick_port_base: free port block below Int16 limit and ephemeral range
	tests/payload/character-transfer = dune-character export/validate/import against the real Funcom schema (login_account fixture, dry-run validation, backup round trip)
	tests/payload/db-setup = Payload-tier test: Funcom 1.5 schema install is complete and idempotent
	tests/payload/dotnet-apps = Payload-tier test: TextRouter and Director run natively; originals untouched
	tests/payload/gm-allowlist = Guard: every GM command dune-server denies exists in Funcom's GM allow-list; all Destroy* are denied
	tests/payload/textrouter-auth = Payload test: TextRouter denies unknown users and authenticates itself to game broker
	tests/payload/world-partitions = Single Survival_1 partition, idempotent
	tests/unit/envrc = .envrc classifier: dune short name offered only when PATH has no dune
	tests/unit/port-guards = Launchers refuse RMQ ports above Int16 max 32767
	tests/unit/ports = Classifier test for pick_port_base (mutation-checked)
	tests/unit/public-hygiene = host tier: templates only in config.sample, filled-in names gitignored, no JWT-shaped tokens tracked
	tests/unit/unpack = Synthetic image: plain+gzip layers, whiteouts, opaque dirs
	tests/unit/usersettings = Defaults deployed, overrides win, idempotent
]
