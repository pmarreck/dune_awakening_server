#!/usr/bin/env bash
# The generated item list read from the game's own tables (dune-items refresh) links ids to names correctly, checked
# against pairs verified in game, and the curated data/items.tsv agrees with the game: every id it marks verified is a
# real item, and "emf generator" never resolves to the recipe-rejected D_FremenComponent3. With DUNE_RETOC set the list
# is regenerated from the unpacked server's Paks; otherwise the operator's private list is checked (run
# `dune-awakening items refresh` after each game update).
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
. libexec/dune-dirs.bash
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
: "${DUNE_SERVER_SRC:=$DUNE_DATA_ROOT/unpacked/server/rootfs/home/dune/server}"
export DUNE_SERVER_SRC
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-items-payload.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
if [ -n "${DUNE_RETOC:-}" ]; then
	list="$work/generated.tsv"
	libexec/dune-items refresh --out "$list" 2>"$work/err" || { fail "refresh: $(cat "$work/err")"; exit 1; }
else
	list=${DUNE_ITEMS_GENERATED:-${DUNE_STATE_DIR:-$DUNE_DATA_ROOT/runtime}/items/generated.tsv}
	[ -f "$list" ] || { printf 'FAIL payload missing: %s (run dune-awakening items refresh; needs DUNE_RETOC)\n' "$list" >&2; exit 1; }
fi
[ "$(stat -c %a "$list")" = 600 ] || fail "$list is not 0600"
[ "$(grep -vc '^#' "$list")" -gt 1000 ] || fail "suspiciously few items in $list"
# Pairs verified in game (docs/admin.md): id -> display name, and the deprecated flag of the EMF Generator twin.
for pair in "SolarisCoin	Solari	0" "HarkAr2	Karpov 38	0" "FremenComponent1	EMF Generator	0" "D_FremenComponent3	EMF Generator	1" \
	"FuelCanister_Large	Large Vehicle Fuel Cell	0"; do
	grep -qP "^\Q$pair\E\t" "$list" || fail "not in the generated list: $(tr '\t' '|' <<<"$pair")"
done
# Stack sizes (StackAndDurability.MaxStackSize, fifth column) as read from the 1.5 tables; they fit the items (coins,
# darts and resources stack, a rifle and a fuel cell do not) but are not checked in game.
for pair in SolarisCoin=50000 Ammo=1000 HeavyAmmo=1000 FremenComponent1=500 HarkAr2=1 FuelCanister_Large=1; do
	got=$(awk -F'\t' -v id="${pair%%=*}" '$1 == id { print $5 }' "$list")
	[ "$got" = "${pair#*=}" ] || fail "stack size of ${pair%%=*}: got '$got', want ${pair#*=}"
done
[ "$(awk -F'\t' '!/^#/ && $5 == ""' "$list" | wc -l)" -lt 50 ] || fail "many items without a stack size in $list"
export DUNE_ITEMS_GENERATED="$list"
# The most one give hands out: curated max count, else the stack size (at least 10), else 1000.
for c in "solari=1000000" "emf generator=500" "light darts=1000" "karpov-38=10" "large vehicle fuel cell=10"; do
	got=$(libexec/dune-items find "${c%%=*}" 2>&1 | cut -f3)
	[ "$got" = "max ${c#*=}" ] || fail "find ${c%%=*} cap: got $got, want max ${c#*=}"
done
for c in "emf generator=FremenComponent1" "EMF Generator=FremenComponent1" "solari=SolarisCoin" "karpov 38=HarkAr2" "sandbike psu=SandbikeGenerator_1"; do
	got=$(libexec/dune-items find "${c%%=*}" 2>&1 | cut -f1)
	[ "$got" = "${c#*=}" ] || fail "find ${c%%=*}: got $got, want ${c#*=}"
done
# Every id the curated list calls verified is an item in the game's tables.
while IFS=$'\t' read -r id verified _; do
	case "$id" in ''|'#'*) continue ;; esac
	[ "$verified" = yes ] || continue
	cut -f1 "$list" | grep -qxF "$id" || fail "data/items.tsv marks $id verified, but the game's tables have no such item"
done < data/items.tsv
exit "$failures"
