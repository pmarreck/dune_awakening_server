#!/usr/bin/env bash
# libexec/dune-live: live-world commands, grouped by what they act on (world, character), through Funcom's server-command channel (Version 2 envelope published by the
# game RabbitMQ node into exchange heartbeats / routing key notifications, as user fls / app fls_backend), with
# players resolved to Funcom ids from a synthetic database. The broker is a fake dune-rabbitmq that records what
# would be published; the auth token must never appear on any command line.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
. tests/lib/ports.bash
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-live-test.XXXXXX") || exit 1
export DUNE_PG_DATA="$work/pg" DUNE_SECRETS_DIR="$work/secrets" DUNE_STATE_DIR="$work/state" DUNE_PG_PORT=$(pick_port_base 1)
export DUNE_COMPONENTS_DIR="$work/fake"
cleanup() { libexec/dune-postgres stop >/dev/null 2>&1; rm -r -- "$work"; }
trap cleanup EXIT
libexec/dune-postgres init >/dev/null 2>&1 && libexec/dune-postgres start >/dev/null 2>&1 || { fail "cluster"; exit 1; }
admin_pw=$(cat "$DUNE_SECRETS_DIR/postgres_admin_password")
q() { PGPASSWORD="$admin_pw" psql -X -A -t -q -v ON_ERROR_STOP=1 -h 127.0.0.1 -p "$DUNE_PG_PORT" -U postgres -d "${2:-dune_sb_9_9_9_9}" -c "$1"; }
q "create database dune_sb_9_9_9_9" postgres
q "set check_function_bodies = off; create schema dune; create table dune.accounts (id bigint primary key, \"user\" text, funcom_id text);
	create table dune.player_state (id bigint primary key, account_id bigint, character_name text, online_status text, player_pawn_id bigint);
	create type dune.vector as (x double precision, y double precision, z double precision);
	create type dune.transform as (location dune.vector, rotation text);
	create table dune.world_partition (partition_id bigint primary key, map text, dimension_index int, label text);
	create table dune.actors (id bigint primary key, map text, partition_id bigint, transform dune.transform);
	insert into dune.accounts values (1, 'fls-1', 'funcom-tester'), (2, 'fls-2', 'funcom-o''brien');
	insert into dune.player_state values (1, 1, 'Tester', 'Online', 11), (2, 2, 'O''Brien', 'Offline', 12);
	insert into dune.world_partition values (1, 'Survival_1', 0, 'Abbir'), (2, 'DeepDesert_1', 0, 'Deep');
	insert into dune.actors values (11, 'HaggaBasin', 1, row(row(1, 2, 3), 'r')), (12, 'HaggaBasin', 1, row(row(10.5, -20, 30), 'r'));
	-- Stand-ins with the contracts of Funcom's procedures (same names, arguments, offline check and error text).
	create function dune.is_player_offline(in_fls_id text) returns boolean language sql as
		\$\$ select not exists (select 1 from player_state ps join accounts a on a.id = ps.account_id where a.\"user\" = in_fls_id and ps.online_status <> 'Offline') \$\$;
	create function dune.admin_move_offline_player_to_partition(in_fls_id text, in_target_partition_id bigint, in_target_location dune.vector)
	returns void language plpgsql as \$\$ begin
		if exists (select 1 from player_state ps join accounts a on a.id = ps.account_id where a.\"user\" = in_fls_id and ps.online_status <> 'Offline') then
			raise exception 'Player must be Offline'; end if;
		update actors set transform = (in_target_location, (transform).rotation), partition_id = in_target_partition_id,
			map = (select map from world_partition where partition_id = in_target_partition_id)
		where id = (select ps.player_pawn_id from player_state ps join accounts a on a.id = ps.account_id where a.\"user\" = in_fls_id);
	end \$\$"
export DUNE_DB_NAME=dune_sb_9_9_9_9
printf 'sekrit-token-value\n' > "$DUNE_SECRETS_DIR/server_commands_token"; chmod 600 "$DUNE_SECRETS_DIR/server_commands_token"

# Fake broker: record argv, and copy the file the eval reads (the published body) to published.json.
mkdir -p "$DUNE_COMPONENTS_DIR"
cat > "$DUNE_COMPONENTS_DIR/dune-rabbitmq" <<EOF
#!$BASH
printf '%s\n' "\$*" >> "$work/argv"
[ -e "$work/broker-down" ] && exit 1
f=\$(printf '%s' "\$*" | sed -n 's/.*file:read_file("\([^"]*\)").*/\1/p')
[ -n "\$f" ] && cp "\$f" "$work/published.json" && stat -c %a "\$f" > "$work/published.mode"
printf 'publish=ok exchange=heartbeats routing=notifications\n'
EOF
chmod +x "$DUNE_COMPONENTS_DIR/dune-rabbitmq"
world() { : > "$work/argv"; rm -f -- "$work/published.json"; libexec/dune-live world "$@"; }
char() { : > "$work/argv"; rm -f -- "$work/published.json"; libexec/dune-live character "$@"; }
inner() { jq -c '.MessageContent | fromjson' "$work/published.json" 2>/dev/null; }

libexec/dune-live --help >/dev/null 2>&1 || fail "--help exited nonzero"
world bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown world command did not exit 2"
# Commands are namespaced by what they act on: a character command is not a world command and vice versa.
libexec/dune-live kick Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "a command without its world/character group was accepted"
world kick Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "kick accepted as a world command"
char say hi >/dev/null 2>&1; [ $? -eq 2 ] || fail "say accepted as a character command"
world players >/dev/null 2>&1; [ $? -eq 2 ] || fail "players still exists (character list covers it)"

out=$(char kick Tester 2>&1) || fail "kick failed: $out"
[ "$(jq -r '[.Version, .AuthToken] | join(",")' "$work/published.json" 2>/dev/null)" = "2,sekrit-token-value" ] || fail "envelope wrong: $(cat "$work/published.json" 2>/dev/null)"
[ "$(inner)" = '{"ServerCommand":"KickPlayer","PlayerId":"funcom-tester"}' ] || fail "kick payload: $(inner)"
[ "$(cat "$work/published.mode")" = 600 ] || fail "published body file not 0600"
grep -q 'heartbeats' "$work/argv" && grep -q 'notifications' "$work/argv" && grep -q 'fls_backend' "$work/argv" || fail "eval does not target heartbeats/notifications as fls_backend"
grep -q sekrit "$work/argv" && fail "auth token appeared on the broker command line"
[ -z "$(find "$DUNE_SECRETS_DIR" -name '*.cmd.json')" ] || fail "command body file left behind"

world kick-all >/dev/null 2>&1 || fail "kick-all failed"
[ "$(inner | jq -r .PlayerId)" = '*' ] || fail "kick-all not PlayerId *"
char kick "O'Brien" >/dev/null 2>&1 || fail "kick of a quoted name failed"
[ "$(inner | jq -r .PlayerId)" = "funcom-o'brien" ] || fail "name with a quote resolved wrongly: $(inner)"
out=$(char kick Nobody 2>&1); [ $? -eq 1 ] && [[ "$out" == *Nobody* ]] || fail "unknown player: $out"

# character move with coordinates, player online: the server's TeleportTo (no database write, no backup).
char move Tester 1.5 -2 300 >/dev/null 2>&1 || fail "online character move failed"
[ "$(inner | jq -c '[.ServerCommand, .PlayerId, .X, .Y, .Z]')" = '["TeleportTo","funcom-tester",1.5,-2,300]' ] || fail "online move payload: $(inner)"
char move Tester 1 x 3 >/dev/null 2>&1; [ $? -eq 2 ] || fail "non-numeric coordinate not a usage error"
char >/dev/null 2>&1; [ $? -eq 2 ] || fail "char without a subcommand not a usage error"
char dance Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown char subcommand not a usage error"
char teleport Tester 1 2 3 >/dev/null 2>&1; [ $? -eq 2 ] || fail "old teleport still accepted (move replaces it)"

world say "Spice must flow" --duration 12 >/dev/null 2>&1 || fail "say failed"
[ "$(inner | jq -c '[.ServerCommand, .BroadcastType, .BroadcastPayload.BroadcastDuration, .BroadcastPayload.LocalizedText[0].Body]')" = '["ServiceBroadcast","Generic",12,"Spice must flow"]' ] || fail "say payload: $(inner)"

char worm Tester >/dev/null 2>&1 || fail "worm failed"
[ "$(inner | jq -c '[.ServerCommand, .PlayerId, .Exec]')" = '["ServerExec","funcom-tester","SandwormTargetPlayer Tester"]' ] || fail "worm payload: $(inner)"

# exec: a world-level console command or variable through ServerExec (arguments joined).
world exec t.MaxFPS 5 >/dev/null 2>&1 || fail "exec failed"
[ "$(inner)" = '{"ServerCommand":"ServerExec","Exec":"t.MaxFPS 5"}' ] || fail "exec payload: $(inner)"
world exec >/dev/null 2>&1; [ $? -eq 2 ] || fail "exec without a command not a usage error"
char water Tester 5000 >/dev/null 2>&1 || fail "water failed"
[ "$(inner | jq -c '[.ServerCommand, .PlayerId, .WaterAmount]')" = '["UpdateAllWaterFillables","funcom-tester",5000]' ] || fail "water payload: $(inner)"
char xp Tester 1000 >/dev/null 2>&1 || fail "xp failed"
[ "$(inner | jq -c '[.ServerCommand, .Experience, .Category]')" = '["AwardXP",1000,"Combat"]' ] || fail "xp payload: $(inner)"
char xp Tester 10 Gathering >/dev/null 2>&1 && [ "$(inner | jq -r .Category)" = Gathering ] || fail "xp category"
char xp Tester 10 Dancing >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown xp category not a usage error"

world raw PrintNumPlayers --player Tester Count=3:int Rate=0.5:float Label=hi >/dev/null 2>&1 || fail "raw failed"
[ "$(inner | jq -c '[.ServerCommand, .PlayerId, .Count, .Rate, .Label]')" = '["PrintNumPlayers","funcom-tester",3,0.5,"hi"]' ] || fail "raw payload: $(inner)"


# timeout: a fake server that applies ServerExec cvar commands and echoes values into its log like the real one.
export DUNE_SERVER_LOG="$work/server.log" DUNE_TIMEOUT_WAIT=3
: > "$DUNE_SERVER_LOG"
printf 'Dac.DamageEnabled=true\nsandworm.dune.Enabled=1\nSandstorm.Enabled=0\nCoriolis.Enabled=1\n' > "$work/cvars"
cat > "$DUNE_COMPONENTS_DIR/dune-rabbitmq" <<FAKE
#!$BASH
f=\$(printf '%s' "\$*" | sed -n 's/.*file:read_file("\([^"]*\)").*/\1/p')
[ -e "$work/broker-down" ] && exit 1
[ -e "$work/server-silent" ] && { echo publish=ok; exit 0; }
exec=\$(jq -r '.MessageContent | fromjson | .Exec // empty' "\$f")
printf '%s\n' "\$(jq -r '.MessageContent | fromjson | .ServerCommand' "\$f") \$exec" >> "$work/sent"
if [ -n "\$exec" ]; then
	set -- \$exec
	if [ \$# -ge 2 ]; then v=\$2; [ "\$1" = Dac.DamageEnabled ] && { [ "\$2" = 0 ] && v=false || v=true; }; sed -i "s/^\$1=.*/\$1=\$v/" "$work/cvars"; fi
	printf '[x]Log: %s = "%s"      LastSetBy: Console\n' "\$1" "\$(sed -n "s/^\$1=//p" "$work/cvars")" >> "$DUNE_SERVER_LOG"
fi
echo publish=ok
FAKE
: > "$work/sent"
out=$(world timeout on 2>&1) || fail "timeout on failed: $out"
[ "$(paste -sd, "$work/cvars")" = "Dac.DamageEnabled=false,sandworm.dune.Enabled=0,Sandstorm.Enabled=0,Coriolis.Enabled=0" ] || fail "timeout on did not switch everything off: $(paste -sd, "$work/cvars")"
grep -q '^ServiceBroadcast' "$work/sent" || fail "timeout on did not tell the players"
out=$(world timeout status 2>&1); [[ "$out" == *on* ]] || fail "timeout status while on: $out"
world bio-break >/dev/null 2>&1 || fail "bio-break alias failed while already on"
out=$(world timeout off 2>&1) || fail "timeout off failed: $out"
[ "$(paste -sd, "$work/cvars")" = "Dac.DamageEnabled=true,sandworm.dune.Enabled=1,Sandstorm.Enabled=0,Coriolis.Enabled=1" ] || fail "timeout off did not restore the previous values: $(paste -sd, "$work/cvars")"
out=$(world timeout status 2>&1); [[ "$out" == *off* ]] || fail "timeout status after off: $out"
for alias in call-timeout safety-first; do world "$alias" >/dev/null 2>&1 || fail "$alias failed"; world timeout off >/dev/null 2>&1; done
touch "$work/server-silent"
out=$(world timeout on 2>&1); [ $? -eq 1 ] && [[ "$out" == *verif* ]] || fail "unverified timeout not reported: $out"
unlink "$work/server-silent"

# partitions / where (read-only, straight from world_partition and actors; Funcom's admin_get_* readers are broken in 1.5).
json=$(world partitions --json 2>&1) || fail "partitions failed: $json"
[ "$(jq -c '[.[] | [.id, .label, .map]]' <<<"$json" 2>/dev/null)" = '[[1,"Abbir","Survival_1"],[2,"Deep","DeepDesert_1"]]' ] || fail "partitions: $json"
json=$(char where "O'Brien" --json 2>&1) || fail "where failed: $json"
[ "$(jq -c '[.name, .online, .partition, .map, .x, .y, .z]' <<<"$json" 2>/dev/null)" = '["O'"'"'Brien",false,"Abbir","HaggaBasin",10.5,-20,30]' ] || fail "where: $json"
out=$(char where Nobody 2>&1); [ $? -eq 1 ] && [[ "$out" == *Nobody* ]] || fail "where for an unknown player: $out"

# move: offline players only, a backup first, Funcom's procedure does the move.
cat > "$DUNE_COMPONENTS_DIR/dune-backup" <<FAKE
#!$BASH
printf '%s\n' "\$*" >> "$work/backup-argv"
[ -e "$work/backup-fails" ] && { echo "disk full" >&2; exit 1; }
echo "backup created"
FAKE
chmod +x "$DUNE_COMPONENTS_DIR/dune-backup"
where_xyz() { char where "$1" --json 2>/dev/null | jq -c '[.partition, .x, .y, .z]'; }
: > "$work/backup-argv"
out=$(char move "O'Brien" 100 200.5 -300 2>&1) || fail "move failed: $out"
[ "$(where_xyz "O'Brien")" = '["Abbir",100,200.5,-300]' ] || fail "move did not land: $(where_xyz "O'Brien")"
[ "$(cat "$work/backup-argv")" = "create --label pre-move" ] || fail "move did not back up first: $(cat "$work/backup-argv")"
char move "O'Brien" 1 2 3 --partition Deep >/dev/null 2>&1 && [ "$(where_xyz "O'Brien")" = '["Deep",1,2,3]' ] || fail "move --partition LABEL: $(where_xyz "O'Brien")"
char move "O'Brien" 4 5 6 --partition 1 >/dev/null 2>&1 && [ "$(where_xyz "O'Brien")" = '["Abbir",4,5,6]' ] || fail "move --partition ID: $(where_xyz "O'Brien")"
out=$(char move "O'Brien" 1 2 3 --partition Nowhere 2>&1); [ $? -eq 1 ] && [[ "$out" == *Nowhere* ]] || fail "unknown partition: $out"
out=$(char move Tester 1 2 3 --partition Deep 2>&1); [ $? -eq 1 ] && [[ "$out" == *offline* ]] && [[ "$out" != *ERROR* ]] || fail "partition change for an online player not refused cleanly: $out"
[ "$(where_xyz Tester)" = '["Abbir",1,2,3]' ] || fail "online player moved anyway"
char move "O'Brien" 1 x 3 >/dev/null 2>&1; [ $? -eq 2 ] || fail "non-numeric move coordinate not a usage error"
touch "$work/backup-fails"
out=$(char move "O'Brien" 7 8 9 2>&1); [ $? -eq 1 ] && [[ "$out" == *backup* ]] || fail "failed backup not reported: $out"
[ "$(where_xyz "O'Brien")" = '["Abbir",4,5,6]' ] || fail "moved despite a failed backup"
unlink "$work/backup-fails"

# whisper: private chat line to an online player through chat.whispers and the player's own <FLS id>_queue.
cat > "$DUNE_COMPONENTS_DIR/dune-rabbitmq" <<FAKE
#!$BASH
printf '%s\n' "\$*" >> "$work/argv"
[ -e "$work/broker-down" ] && exit 1
f=\$(printf '%s' "\$*" | sed -n 's/.*file:read_file("\([^"]*\)").*/\1/p')
[ -n "\$f" ] && cp "\$f" "$work/published.json"
if [ -e "$work/no-queue" ]; then echo whisper=noqueue; else echo whisper=ok; echo publish=ok; fi
FAKE
char whisper Tester "Water is life" >/dev/null 2>&1 || fail "whisper failed"
grep -q 'chat.whispers' "$work/argv" && grep -q '<<"fls-1_queue">>' "$work/argv" && grep -q '<<"fls-1">>' "$work/argv" || fail "whisper not routed to chat.whispers / fls-1_queue: $(cat "$work/argv")"
[ "$(jq -r .Type "$work/published.json" 2>/dev/null)" = TextChat ] || fail "whisper wrapper: $(cat "$work/published.json" 2>/dev/null)"
[ "$(jq -c '.content | fromjson | [.m_ChannelType, .m_UserNameTo, .m_Message.m_UnlocalizedMessage, .m_SpoofedUserNameFrom.m_UnlocalizedName, .m_bUseSpoofedUserName]' "$work/published.json" 2>/dev/null)" = '["Whispers","Tester","Water is life","Admin",true]' ] || fail "whisper payload: $(jq -c '.content | fromjson' "$work/published.json" 2>/dev/null)"
[[ "$(jq -r '.content | fromjson | .m_TimeStamp' "$work/published.json" 2>/dev/null)" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[0-9]{2}\.[0-9]{2}\.[0-9]{2}$ ]] || fail "whisper timestamp format"
char whisper Tester hello there --from Paul >/dev/null 2>&1 && [ "$(jq -r '.content | fromjson | [.m_SpoofedUserNameFrom.m_UnlocalizedName, .m_Message.m_UnlocalizedMessage] | join("|")' "$work/published.json")" = "Paul|hello there" ] || fail "whisper --from / multi-word message"
touch "$work/no-queue"
out=$(char whisper "O'Brien" hi 2>&1); [ $? -eq 1 ] && [[ "$out" == *online* ]] || fail "whisper to a player without a chat queue: $out"
unlink "$work/no-queue"
char whisper Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "whisper without a message not a usage error"

# move to a player: both online -> the game's own TeleportToPlayer in the mover's context; mover offline -> move to the target's
# last saved spot (backup first); mover online but target offline -> refused.
: > "$work/backup-argv"
out=$(char move "O'Brien" to Tester 2>&1) || fail "offline move to a player failed: $out"
[ "$(where_xyz "O'Brien")" = "$(where_xyz Tester)" ] || fail "offline move to a player did not land on the target: $(where_xyz "O'Brien") vs $(where_xyz Tester)"
[ "$(cat "$work/backup-argv")" = "create --label pre-move" ] || fail "offline move to a player did not back up first"
out=$(char move Tester to "O'Brien" 2>&1); [ $? -eq 1 ] && [[ "$out" == *"O'Brien"*offline* ]] || fail "online mover to an offline target not refused: $out"
q "update dune.player_state set online_status = 'Online' where character_name = 'O''Brien'"
char move Tester "O'Brien" >/dev/null 2>&1 || fail "online move to a player failed"
[ "$(inner | jq -c '[.ServerCommand, .PlayerId, .Exec]')" = '["ServerExec","funcom-tester","TeleportToPlayer O'"'"'Brien"]' ] || fail "online move to a player payload: $(inner)"
q "update dune.player_state set online_status = 'Offline' where character_name = 'O''Brien'"
char move Tester to Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "move to a player to oneself not a usage error"
char move Tester >/dev/null 2>&1; [ $? -eq 2 ] || fail "move to a player without a target not a usage error"
out=$(char move Tester to Nobody 2>&1); [ $? -eq 1 ] && [[ "$out" == *Nobody* ]] || fail "move to a player to an unknown player: $out"

touch "$work/broker-down"
out=$(char kick Tester 2>&1); [ $? -eq 1 ] && [[ "$out" == *publish* ]] || fail "broker failure not reported: $out"
[ -z "$(find "$DUNE_SECRETS_DIR" -name '*.cmd.json')" ] || fail "command body file left behind after a failed publish"
exit "$failures"
