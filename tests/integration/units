#!/usr/bin/env bash
# libexec/dune-units render: systemd user units for supervision (world at boot, self-heal timer), scheduled backups,
# weekly restore drill and a daily update check, rendered with this checkout's path and the host's nix.
# systemd-analyze verify runs in the host-tier tests/integration/units-verify.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-units-test.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
fake_nix="$work/nix bin/nix"; mkdir -p "${fake_nix%/*}"; printf '#!%s\nexit 0\n' "$BASH" > "$fake_nix"; chmod +x "$fake_nix"
out="$work/units out"

libexec/dune-units --help >/dev/null 2>&1 || fail "--help exited nonzero"
libexec/dune-units bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown command did not exit 2"
msg=$(libexec/dune-units render "$out" --nix "$fake_nix" 2>&1) || fail "render failed: $msg"
want="dune-backup-verify.service dune-backup-verify.timer dune-backup.service dune-backup.timer dune-update-check.service dune-update-check.timer dune-world-heal.service dune-world-heal.timer dune-world.service"
[ "$(ls "$out" 2>/dev/null | collate | paste -sd' ' -)" = "$want" ] || fail "unit set: $(ls "$out" 2>/dev/null | paste -sd' ' -)"
# The unit's stop must not be blocked by the players-online guard (shutdown and reboot have to work).
grep -q '^ExecStop=.*dune-awakening" stop --force$' "$out/dune-world.service" || fail "world unit does not stop with --force: $(grep ExecStop "$out/dune-world.service")"
grep -rq '@[A-Z_]*@' "$out" && fail "unrendered placeholders: $(grep -rho '@[A-Z_]*@' "$out" | collate | uniq | paste -sd' ' -)"
# Every Exec* program must be an existing absolute path (the checkout's scripts, the given nix, systemctl).
while IFS= read -r prog; do
	[ -x "$prog" ] || fail "Exec program missing: $prog"
done < <(sed -n -e 's/^Exec[A-Za-z]*=[-!@+:]*"\([^"]*\)".*/\1/p' -e 't' -e 's/^Exec[A-Za-z]*=[-!@+:]*\([^ ]*\).*/\1/p' "$out"/*.service | collate | uniq)
grep -qF "ExecStart=\"$PWD/bin/dune-awakening\" start" "$out/dune-world.service" || fail "world unit does not run this checkout's dune-awakening"
grep -q '^KillMode=process$' "$out/dune-world-heal.service" || fail "heal unit would kill the components it starts"
grep -q 'is-active --quiet dune-world.service' "$out/dune-world-heal.service" || fail "heal unit not conditioned on the world being wanted up"
# The heal timer runs the cheap heal path (full start only when something is down), not start itself.
grep -q '^ExecStart=.*dune-awakening" heal$' "$out/dune-world-heal.service" || fail "heal unit does not run heal: $(grep ExecStart "$out/dune-world-heal.service")"
grep -q '^Persistent=true$' "$out/dune-backup.timer" || fail "backup timer misses runs across downtime"
grep -q '^ExecStartPost=.*dune-awakening" backup prune$' "$out/dune-backup.service" || fail "backup unit does not prune with the default retention policy: $(grep ExecStartPost "$out/dune-backup.service")"
grep -q '^SuccessExitStatus=1$' "$out/dune-update-check.service" || fail "update available should not mark the check failed"
# Hourly, announcing each new build once (a daily check missed a build published mid-morning for 12 hours); it never
# applies the update.
grep -qFx 'OnCalendar=*-*-* 00/3:00:00' "$out/dune-update-check.timer" || fail "update check not every 3 hours: $(grep OnCalendar "$out/dune-update-check.timer")"
grep -q '^ExecStart=.*dune-awakening" update check --json --notify$' "$out/dune-update-check.service" || fail "update check does not notify: $(grep ExecStart "$out/dune-update-check.service")"
grep -q 'apply' "$out/dune-update-check.service" && fail "update check unit applies updates"
p=$(sed -n 's/^Environment="PATH=\(.*\)"$/\1/p' "$out/dune-world.service"); [ "$(tr : '\n' <<<"$p" | collate | uniq -d)" = "" ] || fail "duplicate PATH entries: $p"

# Sandbox (docs/hardening.md, step 2): every component runs as a child of the world or heal unit, so these units carry
# only directives that every component tolerates and that need no mount namespace (heal and the world would otherwise
# start components in different namespaces). tests/integration/units-sandbox runs the components under exactly the
# directives rendered here.
sandbox="NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK"
for u in dune-world.service dune-world-heal.service dune-backup.service dune-backup-verify.service; do
	while IFS= read -r d; do grep -qFx "$d" "$out/$u" || fail "$u lacks $d"; done <<<"$sandbox"
done
# Not allowed while components share one unit: W^X breaks .NET; a syscall filter, private /tmp or /dev, and the
# ProtectSystem/ProtectHome/ProtectKernel* family are untested on the map server or need a mount namespace.
grep -E '^(MemoryDenyWriteExecute|SystemCallFilter|PrivateTmp|PrivateDevices|ProtectSystem|ProtectHome|ProtectKernel[A-Za-z]*|ProtectControlGroups|ProtectClock|PrivateUsers)=' "$out"/dune-world*.service "$out"/dune-backup*.service &&
	fail "a directive that one of the components cannot run under is set"
# steamcmd (steam-run, bubblewrap) needs user and mount namespaces: the update check keeps its own rules.
grep -q '^RestrictNamespaces=yes$' "$out/dune-update-check.service" && fail "update check forbids the namespaces steamcmd needs"
exit "$failures"
