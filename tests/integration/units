#!/usr/bin/env bash
# libexec/dune-units render: systemd user units for supervision (world at boot, self-heal timer), scheduled backups,
# weekly restore drill and a daily update check, rendered with this checkout's path and the host's nix.
# systemd-analyze verify runs in the host-tier tests/integration/units-verify.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-units-test.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
fake_nix="$work/nix bin/nix"; mkdir -p "${fake_nix%/*}"; printf '#!%s\nexit 0\n' "$BASH" > "$fake_nix"; chmod +x "$fake_nix"
out="$work/units out"

libexec/dune-units --help >/dev/null 2>&1 || fail "--help exited nonzero"
libexec/dune-units bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown command did not exit 2"
msg=$(libexec/dune-units render "$out" --nix "$fake_nix" 2>&1) || fail "render failed: $msg"
want="dune-backup-verify.service dune-backup-verify.timer dune-backup.service dune-backup.timer dune-update-check.service dune-update-check.timer dune-world-heal.service dune-world-heal.timer dune-world.service"
[ "$(ls "$out" 2>/dev/null | sort | paste -sd' ' -)" = "$want" ] || fail "unit set: $(ls "$out" 2>/dev/null | paste -sd' ' -)"
grep -rq '@[A-Z_]*@' "$out" && fail "unrendered placeholders: $(grep -rho '@[A-Z_]*@' "$out" | sort -u | paste -sd' ' -)"
# Every Exec* program must be an existing absolute path (the checkout's scripts, the given nix, systemctl).
while IFS= read -r prog; do
	[ -x "$prog" ] || fail "Exec program missing: $prog"
done < <(sed -n -e 's/^Exec[A-Za-z]*=[-!@+:]*"\([^"]*\)".*/\1/p' -e 't' -e 's/^Exec[A-Za-z]*=[-!@+:]*\([^ ]*\).*/\1/p' "$out"/*.service | sort -u)
grep -qF "ExecStart=\"$PWD/bin/dune-world\" start" "$out/dune-world.service" || fail "world unit does not run this checkout's dune-world"
grep -q '^KillMode=process$' "$out/dune-world-heal.service" || fail "heal unit would kill the components it starts"
grep -q 'is-active --quiet dune-world.service' "$out/dune-world-heal.service" || fail "heal unit not conditioned on the world being wanted up"
grep -q '^Persistent=true$' "$out/dune-backup.timer" || fail "backup timer misses runs across downtime"
grep -q '^ExecStartPost=.*dune-world" backup prune$' "$out/dune-backup.service" || fail "backup unit does not prune with the default retention policy: $(grep ExecStartPost "$out/dune-backup.service")"
grep -q '^SuccessExitStatus=1$' "$out/dune-update-check.service" || fail "update available should not mark the check failed"
p=$(sed -n 's/^Environment="PATH=\(.*\)"$/\1/p' "$out/dune-world.service"); [ "$(tr : '\n' <<<"$p" | sort | uniq -d)" = "" ] || fail "duplicate PATH entries: $p"
exit "$failures"
