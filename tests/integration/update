#!/usr/bin/env bash
# libexec/dune-update: staleness check (installed Steam build vs Steam's public branch, from steamcmd app_info_print)
# and the update procedure, driven against a fake steamcmd and fake component scripts that log their calls.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-update-test.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
export DUNE_STEAM_SERVER_DIR="$work/steam server" DUNE_UNPACKED_DIR="$work/unpacked" DUNE_TRASH_DIR="$work/trash"
export DUNE_STEAMCMD_HOME="$work/steamcmd-home" DUNE_COMPONENTS_DIR="$work/fake" DUNE_STEAMCMD="$work/fake/steamcmd"
export DUNE_STATE_DIR="$work/state" DUNE_CONFIG_DIR="$work/config"
unset DUNE_NOTIFY_TO DUNE_NOTIFY_CMD DUNE_WORLD_DISPLAY_NAME
mkdir -p "$DUNE_STEAM_SERVER_DIR/steamapps" "$DUNE_COMPONENTS_DIR"
for i in server server-bg-director server-text-router server-gateway server-db-utils; do mkdir -p "$DUNE_UNPACKED_DIR/$i"; echo old > "$DUNE_UNPACKED_DIR/$i/marker"; done
manifest() { printf '"AppState"\n{\n\t"appid"\t\t"4754530"\n\t"buildid"\t\t"%s"\n\t"TargetBuildID"\t\t"%s"\n}\n' "$1" "$1" > "$DUNE_STEAM_SERVER_DIR/steamapps/appmanifest_4754530.acf"; }
echo 100 > "$work/latest"; manifest 100

# Fake steamcmd: app_info_print answers with the "latest" build (shaped like real output, ANSI noise included);
# app_update installs it into the manifest.
cat > "$DUNE_STEAMCMD" <<EOF
#!$BASH
printf 'steamcmd %s\n' "\$*" >> "$work/calls"
[ -e "$work/steam-down" ] && { echo 'Connecting anonymously to Steam Public...FAILED'; exit 7; }
[ -e "$work/download-fails" ] && case "\$*" in *app_update*) echo "ERROR! Download item failed"; exit 8 ;; esac
case "\$*" in
	*app_info_print*) printf '\e[0m"4754530"\n{\n\t"depots"\n\t{\n\t\t"branches"\n\t\t{\n\t\t\t"public"\n\t\t\t{\n\t\t\t\t"buildid"\t\t"%s"\n\t\t\t\t"timeupdated"\t\t"1790247533"\n\t\t\t}\n\t\t\t"beta"\n\t\t\t{\n\t\t\t\t"buildid"\t\t"999"\n\t\t\t}\n\t\t}\n\t}\n}\nUnloading Steam API...\e[0mOK\n' "\$(cat "$work/latest")" ;;
	*app_update*) b=\$(cat "$work/latest"); printf '"AppState"\n{\n\t"buildid"\t\t"%s"\n}\n' "\$b" > "$DUNE_STEAM_SERVER_DIR/steamapps/appmanifest_4754530.acf"; echo "Success! App '4754530' fully installed." ;;
esac
EOF
for c in world backup character; do
	cat > "$DUNE_COMPONENTS_DIR/dune-$c" <<EOF
#!$BASH
printf '%s %s\n' "$c" "\$*" >> "$work/calls"
for fd in /proc/\$\$/fd/*; do [ "\$(readlink "\$fd")" = "$DUNE_STATE_DIR/update.lock" ] && echo "$c" >> "$work/inherited"; done
[ "$c \$*" = "character list --json" ] && { if [ -e "$work/online" ]; then echo '[{"name":"A","online":true}]'; else echo '[{"name":"A","online":false}]'; fi; }
[ "$c" = backup ] && [ "\$1" = create ] && echo "$work/backups/b1"
[ "$c \$1" = "world start" ] && echo "\${DUNE_UPDATE_LOCK_HELD:-}" > "$work/start-lock-held"
[ "$c \$*" = "\${FAIL_AT:-}" ] && { echo "dune-textrouter: TextRouter exited during startup" >&2; exit 1; }
exit 0
EOF
done
# The unpack of server.tar can be held at a gate (two fifos) to look at the world mid-update.
cat > "$DUNE_COMPONENTS_DIR/dune-unpack" <<EOF
#!$BASH
printf 'unpack %s\n' "\${1##*/} \${2##*/}" >> "$work/calls"
[ -e "$work/unpack-fails" ] && exit 1
for fd in /proc/\$\$/fd/*; do [ "\$(readlink "\$fd")" = "$DUNE_STATE_DIR/update.lock" ] && echo unpack >> "$work/inherited"; done
if [ "\${1##*/}" = server.tar ] && [ -p "$work/unpack-gate" ]; then echo started > "$work/unpack-started"; read -r _ < "$work/unpack-gate"; fi
mkdir -p "\$2" && echo new > "\$2/marker"
EOF
chmod +x "$DUNE_COMPONENTS_DIR"/*
calls() { cut -d' ' -f1-2 "$work/calls" | paste -sd, -; }

libexec/dune-update --help >/dev/null 2>&1 || fail "--help exited nonzero"
out=$(libexec/dune-update --about 2>&1); [[ "$out" == *dune-update* && "$(printf '%s\n' "$out" | wc -l)" -eq 1 ]] || fail "--about: $out"
libexec/dune-update bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown command did not exit 2"

# check ------------------------------------------------------------------------------------------------------------
out=$(libexec/dune-update check 2>&1); rc=$?
[ $rc -eq 0 ] && [[ "$out" == *"up to date"* && "$out" == *100* ]] || fail "check when current: rc $rc: $out"
echo 101 > "$work/latest"
json=$(libexec/dune-update check --json 2>"$work/err"); rc=$?
[ $rc -eq 1 ] || fail "check with an update available exited $rc (want 1)"
[ "$(jq -r '[.installed_buildid, .latest_buildid, .up_to_date] | join(",")' <<<"$json" 2>/dev/null)" = "100,101,false" ] || fail "check --json: $json"
[ -s "$work/err" ] && fail "check --json wrote stderr: $(cat "$work/err")"
# Default steamcmd resolved through PATH (a same-named shell function once recursed into itself).
out=$(env -u DUNE_STEAMCMD PATH="$DUNE_COMPONENTS_DIR:$PATH" timeout 20 libexec/dune-update check 2>&1); [ $? -eq 1 ] || fail "check with steamcmd found on PATH: $out"
touch "$work/steam-down"
out=$(libexec/dune-update check 2>&1); rc=$?
[ $rc -eq 3 ] && [[ "$out" == *Steam* ]] || fail "check with Steam unreachable: rc $rc: $out"
rm "$work/steam-down"

# apply ------------------------------------------------------------------------------------------------------------
touch "$work/online"; : > "$work/calls"
out=$(libexec/dune-update apply 2>&1); [ $? -eq 1 ] && [[ "$out" == *online* ]] || fail "apply with players online not refused: $out"
grep -q '^world stop' "$work/calls" && fail "refused apply stopped the world"
rm "$work/online"; : > "$work/calls"
out=$(libexec/dune-update apply 2>&1) || fail "apply failed: $out"
[ "$(calls)" = "steamcmd +login,character list,backup create,world stop,steamcmd +@sSteamCmdForcePlatformType,unpack server.tar,unpack server-bg-director.tar,unpack server-text-router.tar,unpack server-gateway.tar,unpack server-db-utils.tar,world start,steamcmd +login" ] ||
	fail "apply order wrong: $(calls)"
grep -q 'backup create --label before update 100 to 101' "$work/calls" || fail "backup not labeled with the build change: $(grep backup "$work/calls")"
grep -q "^unpack server.tar server.new" "$work/calls" || fail "unpack not into <image>.new"
[ "$(cat "$DUNE_UNPACKED_DIR/server/marker")" = new ] && [ "$(cat "$DUNE_UNPACKED_DIR/server.prev/marker")" = old ] || fail "images not swapped with a .prev kept"
[[ "$out" == *101* ]] || fail "apply does not report the new build: $out"

: > "$work/calls"
out=$(libexec/dune-update apply 2>&1) || fail "apply when current failed: $out"
grep -q '^world stop' "$work/calls" && fail "apply stopped the world with nothing to update"
echo 102 > "$work/latest"; : > "$work/calls"
FAIL_AT="world stop" libexec/dune-update apply >/dev/null 2>&1 && fail "apply succeeded although stop failed"
grep -q 'app_update' "$work/calls" && fail "apply downloaded after a failed stop"
libexec/dune-update apply >/dev/null 2>&1 || fail "second update failed"
[ "$(find "$DUNE_TRASH_DIR" -mindepth 1 -maxdepth 1 -name 'server.prev*' | wc -l)" = 1 ] || fail "older .prev not moved to the trash"
# --force with players online passes --force on to the world stop, whose own players-online guard would refuse.
touch "$work/online"; : > "$work/calls"; libexec/dune-update apply --force >/dev/null 2>&1
grep -qx 'world stop --force' "$work/calls" || fail "apply --force does not force the world stop: $(grep '^world' "$work/calls" | paste -sd, -)"
rm -f "$work/online"

# The update lock: from stopping the world until it is started again, apply holds DUNE_STATE_DIR/update.lock, and the
# self-heal (dune-awakening heal) does nothing meanwhile. On 2026-09-30 the heal timer started the map server from the
# old images during an update's unpack; the update then swapped the images under the running server, which crashed.
mkdir -p -m 700 "$DUNE_CONFIG_DIR"; printf 'WORLD_UNIQUE_NAME=sh-abc-qwerty\nEXTERNAL_ADDRESS=10.1.1.1\n' > "$DUNE_CONFIG_DIR/world.conf"
mkfifo "$work/unpack-started" "$work/unpack-gate"
echo 103 > "$work/latest"; : > "$work/calls"; rm -f "$work/inherited"
libexec/dune-update apply > "$work/apply-out" 2>&1 &
apply_pid=$!
read -r _ < "$work/unpack-started"
[ -e "$DUNE_STATE_DIR/update.lock" ] && ! flock -n "$DUNE_STATE_DIR/update.lock" true || fail "update lock not held during the unpack"
: > "$work/heal-calls"
out=$(bin/dune-awakening heal 2>&1); rc=$?
[ "$rc" -eq 0 ] && [[ "$out" == *update* ]] || fail "heal during an update did not skip: rc $rc: $out"
echo go > "$work/unpack-gate"
wait "$apply_pid" || fail "apply held at the unpack failed: $(cat "$work/apply-out")"
[ "$(grep -c '^world start' "$work/calls")" = 1 ] || fail "world started other than once by the update: $(grep '^world' "$work/calls" | paste -sd, -)"
flock -n "$DUNE_STATE_DIR/update.lock" true || fail "update lock still held after apply"
[ "$(cat "$work/start-lock-held" 2>/dev/null)" = 1 ] || fail "apply's world start lacks DUNE_UPDATE_LOCK_HELD=1 (start would refuse while apply holds the lock)"
[ -e "$work/inherited" ] && fail "update lock descriptor inherited by: $(paste -sd' ' "$work/inherited")"
rm -- "$work/unpack-gate" "$work/unpack-started"
# A heal holding the lock (starting the world) makes apply wait for it, up to DUNE_UPDATE_LOCK_WAIT seconds.
echo 104 > "$work/latest"; : > "$work/calls"
exec 8>>"$DUNE_STATE_DIR/update.lock"; flock 8
out=$(DUNE_UPDATE_LOCK_WAIT=0 libexec/dune-update apply 2>&1); rc=$?
exec 8>&-
[ "$rc" -eq 1 ] && [[ "$out" == *lock* ]] || fail "apply did not give up on a held lock: rc $rc: $out"
grep -q '^world stop' "$work/calls" && fail "apply stopped the world without the lock"

# check --notify (the scheduled timer): one notice per new Steam build, through NOTIFY_CMD with the post tool's
# arguments; the build last announced is kept in DUNE_STATE_DIR/update-notified. Never an automatic apply.
cat > "$work/fake/notify" <<EOF
#!$BASH
printf '%s\n' "\$*" > "$work/last-notice"; echo attempt >> "$work/notices"
[ -e "$work/notify-fails" ] && { echo "module 'luv' not found" >&2; exit 1; }
exit 0
EOF
chmod +x "$work/fake/notify"
export DUNE_NOTIFY_CMD="$work/fake/notify" DUNE_NOTIFY_TO=someone
notices() { [ -e "$work/notices" ] && wc -l < "$work/notices" || echo 0; }
manifest 104; echo 104 > "$work/latest"; rm -f "$work/notices"; : > "$work/calls"
libexec/dune-update check --notify >/dev/null 2>&1; [ $? -eq 0 ] || fail "check --notify when current did not exit 0"
[ "$(notices)" = 0 ] || fail "notice sent with nothing to update"
echo 105 > "$work/latest"
json=$(libexec/dune-update check --json --notify 2>"$work/err"); rc=$?
[ "$rc" -eq 1 ] || fail "check --notify with an update exited $rc (want 1)"
jq -e . >/dev/null 2>&1 <<<"$json" || fail "check --json --notify stdout is not JSON: $json"
[ "$(notices)" = 1 ] || fail "no notice for a new build: $(notices)"
n=$(cat "$work/last-notice" 2>/dev/null)
[[ "$n" == "to someone --as dune_awakening_server --subject "*105*" --body "*105*104*"update apply"*" --yes" ]] || fail "notice arguments: $n"
[ "$(cat "$DUNE_STATE_DIR/update-notified" 2>/dev/null)" = 105 ] || fail "notified build not recorded: $(cat "$DUNE_STATE_DIR/update-notified" 2>/dev/null)"
for _ in 1 2; do libexec/dune-update check --notify >/dev/null 2>&1; done
[ "$(notices)" = 1 ] || fail "notice repeated for the same build: $(notices)"
grep -q '^world \|app_update' "$work/calls" && fail "check --notify applied the update: $(paste -sd, "$work/calls")"
# A failed notice is not recorded, so the next scheduled check tries again.
echo 106 > "$work/latest"; touch "$work/notify-fails"
out=$(libexec/dune-update check --notify 2>&1); [ $? -eq 1 ] || fail "check with a failed notice changed the exit status"
[[ "$out" == *notice*failed* || "$out" == *failed*notice* ]] || fail "failed notice not reported: $out"
[[ "$out" == *"module 'luv' not found"* ]] || fail "the notifier's error is not in the report: $out"
[ "$(cat "$DUNE_STATE_DIR/update-notified")" = 105 ] || fail "failed notice recorded as sent"
rm "$work/notify-fails"
libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 3 ] && [ "$(cat "$DUNE_STATE_DIR/update-notified")" = 106 ] || fail "failed notice not retried: $(notices) notices"
# Without NOTIFY_TO nothing is sent and nothing recorded (configuring it later still announces the pending build).
echo 107 > "$work/latest"
out=$(env -u DUNE_NOTIFY_TO libexec/dune-update check --notify 2>&1)
[ "$(notices)" = 3 ] && [ "$(cat "$DUNE_STATE_DIR/update-notified")" = 106 ] || fail "notice sent or recorded without NOTIFY_TO"
[[ "$out" == *NOTIFY_TO* ]] || fail "missing NOTIFY_TO not mentioned: $out"
# Steam unreachable: no notice.
touch "$work/steam-down"; libexec/dune-update check --notify >/dev/null 2>&1; [ $? -eq 3 ] || fail "check --notify with Steam down"
[ "$(notices)" = 3 ] || fail "notice sent with Steam unreachable"
rm "$work/steam-down"
# A plain check notifies too once NOTIFY_TO is set (a scheduled check without --notify let a build go unannounced
# for four days); --no-notify turns it off, and without NOTIFY_TO a plain check says nothing about notices.
libexec/dune-update check --json --no-notify >/dev/null 2>&1
[ "$(notices)" = 3 ] || fail "check --no-notify sent a notice: $(notices)"
out=$(libexec/dune-update check --json 2>&1 >/dev/null)
[ "$(notices)" = 4 ] && [ "$(cat "$DUNE_STATE_DIR/update-notified")" = 107 ] || fail "plain check did not notify: $(notices) notices: $out"
echo 108 > "$work/latest"
out=$(env -u DUNE_NOTIFY_TO libexec/dune-update check 2>&1 >/dev/null)
[ "$(notices)" = 4 ] && [[ "$out" != *NOTIFY_TO* ]] || fail "plain check without NOTIFY_TO sent or complained: $out"
libexec/dune-update check --no-notify --notify >/dev/null 2>&1
[ "$(notices)" = 5 ] || fail "later --notify did not override --no-notify: $(notices)"

# The same scheduled check announces the Funcom token's expiry (DUNE_CONFIG_DIR/fls_secret, a JWT): one notice once
# under 30 days are left, one under 7, one once expired, each once per token (DUNE_STATE_DIR/token-notified holds
# EXP:STAGE), whatever Steam says; a renewed token starts over. The check's exit status and JSON stay the same.
manifest 108; echo 108 > "$work/latest"; rm -f "$work/notices" "$work/last-notice"
b64url() { base64 -w0 | tr '+/' '-_' | tr -d '='; }
token() { mkdir -p "$DUNE_CONFIG_DIR"; (umask 077; printf '%s.%s.sig\n' "$(printf '{"alg":"none"}' | b64url)" "$(printf '{"exp":%s}' "$1" | b64url)" > "$DUNE_CONFIG_DIR/fls_secret"); }
export DUNE_NOW=2027-08-01T12:00:00Z
now=$(date -d "$DUNE_NOW" +%s) day=86400
exp=$((now + 365 * day)); token "$exp"
libexec/dune-update check --notify >/dev/null 2>&1; [ $? -eq 0 ] || fail "token check changed the exit status"
[ "$(notices)" = 0 ] || fail "token notice with a year left"
exp=$((now + 20 * day + 3600)); token "$exp"
json=$(libexec/dune-update check --json --notify 2>"$work/err"); rc=$?
[ "$rc" -eq 0 ] && jq -e '.up_to_date' >/dev/null 2>&1 <<<"$json" || fail "token notice changed check's result: rc=$rc $json"
[ "$(notices)" = 1 ] || fail "no token notice with 20 days left: $(notices) $(cat "$work/err")"
n=$(cat "$work/last-notice" 2>/dev/null)
[[ "$n" == "to someone --as dune_awakening_server --subject "*"token expires in 20 days"*"$(date -u -d "@$exp" +%F)"*" --body "*account.duneawakening.com*"$DUNE_CONFIG_DIR/fls_secret"*" --yes" ]] ||
	fail "token notice arguments: $n"
[ "$(cat "$DUNE_STATE_DIR/token-notified" 2>/dev/null)" = "$exp:30" ] || fail "token notice not recorded: $(cat "$DUNE_STATE_DIR/token-notified" 2>&1)"
for _ in 1 2; do libexec/dune-update check --notify >/dev/null 2>&1; done
[ "$(notices)" = 1 ] || fail "30-day token notice repeated: $(notices)"
DUNE_NOW=@$((exp - 3 * day)) libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 2 ] && [[ "$(cat "$work/last-notice")" == *"expires in 3 days"* ]] || fail "no 7-day token notice: $(notices) $(cat "$work/last-notice")"
DUNE_NOW=@$((exp - 2 * day)) libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 2 ] || fail "7-day token notice repeated: $(notices)"
DUNE_NOW=@$((exp + day)) libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 3 ] && [[ "$(cat "$work/last-notice")" == *"token expired"* ]] || fail "no expired-token notice: $(notices) $(cat "$work/last-notice")"
[ "$(cat "$DUNE_STATE_DIR/token-notified")" = "$exp:expired" ] || fail "expired notice not recorded"
DUNE_NOW=@$((exp + 9 * day)) libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 3 ] || fail "expired-token notice repeated: $(notices)"
# A renewed token with a year left: nothing. One that is already close: announced again, from scratch.
exp=$((now + 365 * day)); token "$exp"; libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 3 ] || fail "token notice for a renewed token with a year left"
# A failed notice is retried at the next check; Steam being down does not hold it back.
exp=$((now + 10 * day)); token "$exp"; touch "$work/notify-fails" "$work/steam-down"
out=$(libexec/dune-update check --notify 2>&1); rc=$?
[ "$rc" -eq 3 ] || fail "token notice changed the Steam-down exit status: $rc"
[ "$(notices)" = 4 ] && [[ "$out" == *"token"*"failed"*"module 'luv' not found"* ]] || fail "failed token notice not attempted or not reported: $(notices) $out"
[ "$(cat "$DUNE_STATE_DIR/token-notified")" != "$exp:30" ] || fail "failed token notice recorded as sent"
rm "$work/notify-fails"
libexec/dune-update check --notify >/dev/null 2>&1
[ "$(notices)" = 5 ] && [ "$(cat "$DUNE_STATE_DIR/token-notified")" = "$exp:30" ] || fail "failed token notice not retried with Steam down: $(notices)"
rm "$work/steam-down"
# --no-notify, or no NOTIFY_TO on a plain check: nothing sent, nothing said.
exp=$((now + 2 * day)); token "$exp"
libexec/dune-update check --no-notify >/dev/null 2>&1
out=$(env -u DUNE_NOTIFY_TO libexec/dune-update check 2>&1 >/dev/null)
[ "$(notices)" = 5 ] && [[ "$out" != *token* ]] || fail "token notice without notices on: $(notices) $out"
# --notify without NOTIFY_TO says so; an unreadable token is reported on stderr, not mailed.
out=$(env -u DUNE_NOTIFY_TO libexec/dune-update check --notify 2>&1 >/dev/null)
[ "$(notices)" = 5 ] && [[ "$out" == *token*NOTIFY_TO* ]] || fail "token notice without NOTIFY_TO: $(notices) $out"
printf 'garbage\n' > "$DUNE_CONFIG_DIR/fls_secret"
out=$(libexec/dune-update check --notify 2>&1 >/dev/null); rc=$?
[ "$rc" -eq 0 ] && [ "$(notices)" = 5 ] && [[ "$out" == *"cannot read"*fls_secret* ]] || fail "unreadable token: rc=$rc $(notices) $out"
mv "$DUNE_CONFIG_DIR/fls_secret" "$work/fls_secret.unreadable"; unset DUNE_NOW

# apply that leaves the world down (on 2026-11-10 the new TextRouter would not start, and the world stayed down with
# nobody told): one notice naming the build and carrying the failing component's own error, then exit 1.
manifest 108; echo 109 > "$work/latest"; rm -f "$work/notices" "$work/last-notice"
out=$(FAIL_AT="world start" libexec/dune-update apply 2>&1); rc=$?
[ "$rc" -eq 1 ] && [[ "$out" == *"failed to start"* ]] || fail "failed start not reported: rc $rc: $out"
[[ "$out" == *"TextRouter exited during startup"* ]] || fail "the component's error is no longer shown: $out"
[ "$(notices)" = 1 ] || fail "no notice when the world failed to start: $(notices)"
n=$(cat "$work/last-notice" 2>/dev/null)
[[ "$n" == "to someone --as dune_awakening_server --subject "*109*" --body "*"failed to start"*"TextRouter exited during startup"*" --yes" ]] ||
	fail "failed-start notice arguments: $n"
# Every way apply can leave the world stopped is announced: a failed stop, download or unpack.
manifest 108; rm -f "$work/notices"
FAIL_AT="world stop" libexec/dune-update apply >/dev/null 2>&1 && fail "apply succeeded although the stop failed"
[ "$(notices)" = 1 ] || fail "no notice when the stop failed: $(notices)"
manifest 108; rm -f "$work/notices"; touch "$work/download-fails"
libexec/dune-update apply >/dev/null 2>&1 && fail "apply succeeded although the download failed"
rm "$work/download-fails"
[ "$(notices)" = 1 ] || fail "no notice when the download failed: $(notices)"
manifest 108; rm -f "$work/notices"; touch "$work/unpack-fails"
libexec/dune-update apply >/dev/null 2>&1 && fail "apply succeeded although the unpack failed"
rm "$work/unpack-fails"
[ "$(notices)" = 1 ] || fail "no notice when the unpack failed: $(notices)"
# A failed backup changes nothing (the world is still up): no notice.
manifest 108; rm -f "$work/notices"
FAIL_AT="backup create --label before update 108 to 109" libexec/dune-update apply >/dev/null 2>&1 && fail "apply succeeded although the backup failed"
[ "$(notices)" = 0 ] || fail "notice sent although the world was never stopped: $(notices)"
# Without NOTIFY_TO the failure is still reported, and the missing setting is named.
manifest 108; rm -f "$work/notices"
out=$(env -u DUNE_NOTIFY_TO FAIL_AT="world start" libexec/dune-update apply 2>&1)
[ "$(notices)" = 0 ] && [[ "$out" == *NOTIFY_TO* && "$out" == *"failed to start"* ]] || fail "failed start without NOTIFY_TO: $out"
exit "$failures"
