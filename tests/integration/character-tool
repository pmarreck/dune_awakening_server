#!/usr/bin/env bash
# libexec/dune-character against a synthetic Funcom-shaped database: DB settings come from the game's own ini chain,
# schema is feature-detected before any operation, online characters are never edited, every write is backed up.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
. tests/lib/ports.bash
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }

work=$(mktemp -d "${TMPDIR:-/tmp}/dune-char-test.XXXXXX") || exit 1
export DUNE_PG_DATA="$work/pg" DUNE_SECRETS_DIR="$work/secrets" DUNE_PG_PORT=$(pick_port_base 1)
cleanup() { libexec/dune-postgres stop >/dev/null 2>&1; rm -r -- "$work"; }
trap cleanup EXIT
libexec/dune-postgres init >/dev/null && libexec/dune-postgres start >/dev/null || { fail "cluster"; exit 1; }
export PGPASSWORD=$(cat "$DUNE_SECRETS_DIR/postgres_admin_password")
admin() { psql -X -A -t -q -v ON_ERROR_STOP=1 -h 127.0.0.1 -p "$DUNE_PG_PORT" -U postgres -d "${2:-dune_sb_9_9_9_9}" -c "$1"; }
admin "create role dune login password 'dunepw'" postgres && admin "create database dune_sb_9_9_9_9 owner dune" postgres
admin "create schema dune authorization dune;
create table dune.actors (id bigint primary key, class text, properties jsonb not null default '{}', gas_attributes jsonb not null default '{}');
create table dune.encrypted_player_state (id bigint primary key, account_id bigint not null, encrypted_character_name bytea not null,
  online_status text not null default 'Offline', player_pawn_id bigint references dune.actors(id), player_controller_id bigint, player_state_id bigint, character_state text not null default 'Active');
create function dune.decrypt_user_data(v bytea) returns text language sql as \$\$ select convert_from(v, 'UTF8') \$\$;
insert into dune.actors values (40, 'BP_DunePlayerCharacter_C', '{\"TechKnowledgePlayerComponent\": {}}'), (50, 'BP_DunePlayerCharacter_C', '{}'),
  (60, 'BP_DunePlayerCharacter_C', '{\"TechKnowledgePlayerComponent\": {}}'), (70, null, '{}');
insert into dune.actors values (10, 'BP_DunePlayerCharacter_C', '{\"TechKnowledgePlayerComponent\": {\"m_TechKnowledgePoints\": 5}}'),
  (20, 'BP_DunePlayerCharacter_C', '{\"TechKnowledgePlayerComponent\": {}}'), (30, 'BP_DunePlayerCharacter_C', '{\"Other\": {}}');
insert into dune.encrypted_player_state values (1, 1, convert_to('Alice','UTF8'), 'Offline', 10), (2, 2, convert_to('Bob','UTF8'), 'Online', 20),
  (3, 3, convert_to('Carol','UTF8'), 'Offline', 30),
  (4, 4, convert_to('Dave','UTF8'), 'Offline', 40), (5, 4, convert_to('DaveAlt','UTF8'), 'Online', 50),
  (6, 6, convert_to('Erin','UTF8'), 'Offline', 60), (7, 6, convert_to('','UTF8'), 'Online', 70);
update dune.encrypted_player_state set character_state = 'Deleted' where id = 7;
create table dune.fgl_entities (entity_id bigint primary key, components jsonb);
create table dune.actor_fgl_entities (actor_id bigint references dune.actors(id), entity_id bigint unique references dune.fgl_entities(entity_id), slot_name text not null);
insert into dune.fgl_entities values (-100, '{\"FLevelComponent\": [0, {\"TotalSkillPoints\": 5, \"UnspentSkillPoints\": 1, \"TotalXPEarned\": 390}]}'), (-200, '{\"FHealthComponent\": [0, {}]}');
insert into dune.actor_fgl_entities values (10, -100, 'DuneCharacter'), (30, -200, 'DuneCharacter');
alter schema dune owner to dune; alter table dune.actors owner to dune; alter table dune.encrypted_player_state owner to dune; alter table dune.fgl_entities owner to dune; alter table dune.actor_fgl_entities owner to dune;"

# Fake server tree carrying the game's ini chain (BaseGame -> DefaultGame -> Saved Game.ini) and branch keywords.
root="$work/server"
mkdir -p "$root/Engine/Config" "$root/DuneSandbox/Config" "$root/DuneSandbox/Saved/Config/LinuxServer"
printf '[DuneDatabaseInterfacePSQL]\nDatabaseHost=localhost:15431\nDatabaseName=dune%%_BRANCH%%\nDatabaseUser=dune\nDatabasePassword=wrong\n' > "$root/Engine/Config/BaseGame.ini"
printf '[Other]\nx=1\n' > "$root/DuneSandbox/Config/DefaultGame.ini"
printf '{"path": "$File: //seabass/sb-9.9.9.9/DuneSandbox/Config/perforce-keywords.json $"}' > "$root/DuneSandbox/Config/perforce-keywords.json"
printf '[DuneDatabaseInterfacePSQL]\nDatabaseHost=127.0.0.1:%s\nDatabaseUser=dune\nDatabasePassword=dunepw\n' "$DUNE_PG_PORT" > "$root/DuneSandbox/Saved/Config/LinuxServer/Game.ini"
export DUNE_CHARACTER_BACKUP_DIR="$work/backups"
char() { libexec/dune-character --server-root "$root" "$@"; }
intel() { admin "select coalesce((properties->'TechKnowledgePlayerComponent'->>'m_TechKnowledgePoints'), 'absent') from dune.actors where id = $1"; }

out=$(libexec/dune-character --about 2>&1) || fail "--about exited nonzero"
[ "$(printf '%s\n' "$out" | wc -l)" -eq 1 ] && [[ "$out" == *dune-character* ]] && [[ "$out" == *"$(uname -m)"* ]] || fail "--about not one line with name and arch: $out"
libexec/dune-character --help >/dev/null 2>&1 || fail "--help exited nonzero"
libexec/dune-character --bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown option did not exit 2"

json=$(char list --json 2>"$work/err") || fail "list --json failed: $(cat "$work/err")"
[ "$(jq -r '[.[] | "\(.name):\(.online):\(.intel_points)"] | join(",")' <<<"$json" 2>/dev/null)" = "Alice:false:5,Bob:true:0,Carol:false:null,Dave:true:0,DaveAlt:true:null,Erin:false:0" ] ||
	fail "list --json wrong: $json"
out=$(char list --json --text 2>&1) || fail "list --text failed"
jq -e . >/dev/null 2>&1 <<<"$out" && fail "later --text did not override earlier --json"
[[ "$out" == *Alice* && "$out" == *Bob* ]] || fail "text list missing names: $out"

out=$(char set-intel Alice 100 2>&1) || fail "set-intel on offline Alice failed: $out"
[ "$(intel 10)" = 100 ] || fail "Alice intel not 100: $(intel 10)"
b=$(find "$work/backups" -type f 2>/dev/null | head -1)
[ -n "$b" ] && [ "$(stat -c %a "$b")" = 600 ] || fail "no 0600 backup written before the edit"
[ -n "$b" ] && [ "$(jq -r '.properties.TechKnowledgePlayerComponent.m_TechKnowledgePoints' "$b")" = 5 ] || fail "backup does not hold the old value"

out=$(char set-intel Bob 100 2>&1) && fail "edited an online character"
[[ "$out" == *nline* ]] || fail "online refusal does not say why: $out"
[ "$(intel 20)" = absent ] || fail "online character was modified"

out=$(char set-intel Carol 100 2>&1) && fail "edited a character lacking TechKnowledgePlayerComponent"
[ "$(intel 30)" = absent ] || fail "Carol was modified"
# Same account online through another row (the server's login placeholder): the character is in use.
out=$(char set-intel Dave 100 2>&1) && fail "edited a character whose account is online via another row"
[ "$(intel 40)" = absent ] || fail "Dave was modified while his account was online"
# The server leaves its first-login placeholder row Online but character_state Deleted (seen live); it must not block its account's real character.
out=$(char set-intel Erin 7 2>&1) || fail "Deleted placeholder row blocked editing a real offline character: $out"
[ "$(intel 60)" = 7 ] || fail "Erin not updated despite only a Deleted row being online"
out=$(char set-intel Nobody 1 2>&1) && fail "unknown character accepted"
out=$(char set-intel Alice -3 2>&1); [ $? -eq 2 ] || fail "negative amount not a usage error"

skills() { admin "select (e.components->'FLevelComponent'->1->>'UnspentSkillPoints') || '/' || (e.components->'FLevelComponent'->1->>'TotalSkillPoints') from dune.actor_fgl_entities f join dune.fgl_entities e using (entity_id) where f.actor_id = $1 and f.slot_name = 'DuneCharacter'"; }
[ "$(jq -r '.skill_points_unspent' <<<"$(char show Alice --json)")" = 1 ] || fail "show does not report unspent skill points"
out=$(char add-skill-points Alice 20 2>&1) || fail "add-skill-points on offline Alice failed: $out"
[ "$(skills 10)" = 21/25 ] || fail "skill points not 21 unspent / 25 total: $(skills 10)"
# set-skill-points sets the unspent pool; the lifetime total moves by the same amount, so spent points stay counted.
out=$(char set-skill-points Alice 10 2>&1) || fail "set-skill-points failed: $out"
[ "$(skills 10)" = 10/14 ] || fail "set-skill-points: want 10 unspent / 14 total, got $(skills 10)"
out=$(char set-skill-points Alice -1 2>&1); [ $? -eq 2 ] || fail "negative skill points not a usage error"
out=$(char set-skill-points Bob 5 2>&1) && fail "set skill points on an online character"
# add-intel adds to the current Intel points.
out=$(char add-intel Alice 5 2>&1) || fail "add-intel failed: $out"
[ "$(intel 10)" = 105 ] || fail "add-intel: want 105, got $(intel 10)"
out=$(char add-intel Alice 0 2>&1); [ $? -eq 2 ] || fail "add-intel 0 not a usage error"
out=$(char add-intel Carol 5 2>&1) && fail "added Intel to a character lacking TechKnowledgePlayerComponent"
out=$(char set-research Alice 1 2>&1); [ $? -eq 2 ] || fail "old set-research command still accepted"
[ "$(find "$work/backups" -type f -name '*fgl*' | wc -l)" -ge 1 ] || fail "no backup of the FGL entity before the skill edit"
out=$(char add-skill-points Bob 20 2>&1) && fail "added skill points to an online character"
out=$(char add-skill-points Carol 5 2>&1) && fail "added skill points to a character lacking FLevelComponent"
out=$(char add-skill-points Alice 0 2>&1); [ $? -eq 2 ] || fail "zero skill points not a usage error"
# Transfer commands need Funcom's transfer procedures, which this synthetic schema lacks.
for c in "export Alice" "validate /dev/null" "import /dev/null"; do
	out=$(char $c 2>&1) && fail "$c ran without transfer procedures"
	[[ "$out" == *chema*character_transfer_export* ]] || fail "$c did not name the missing transfer procedure: $out"
done
# Live character commands (move, where, kick, water, whisper, worm, give, whois, unlock-tree) go to dune-live's character group with
# the user's arguments in order; this tool's own options (--server-root, -o, --text, --no-color) stay here; exit status
# passes. xp and level are this tool's own (below): they correct for the world's XP multiplier before dune-live sends.
fake="$work/components"; mkdir -p "$fake"
printf '#!%s\nprintf "%%s\\n" "$*" > "%s"\nexit 4\n' "$BASH" "$work/live-argv" > "$fake/dune-live"; chmod +x "$fake/dune-live"
for sub in move where kick water whisper worm give whois unlock-tree; do
	DUNE_COMPONENTS_DIR="$fake" char "$sub" "Some One" --json --no-color x >/dev/null 2>&1; rc=$?
	[ "$(cat "$work/live-argv" 2>/dev/null)" = "character $sub Some One --json x" ] || fail "$sub not handed to dune-live: $(cat "$work/live-argv" 2>/dev/null)"
	[ "$rc" -eq 4 ] || fail "$sub exit status not passed through: $rc"
	unlink "$work/live-argv" 2>/dev/null
done
out=$(char --help 2>&1); for sub in move where kick water xp level whisper worm give whois unlock-tree; do [[ "$out" == *"  $sub "* ]] || fail "--help does not list $sub"; done

# xp: the server multiplies AwardXP by the world's GlobalXpMultiplier (measured 2026-09-30: 4150 sent at x1.5 added
# 6225), so the tool divides first, rounding to the nearest whole amount. The multiplier is read from the settings the
# map server was started with (Saved/UserSettings), else the operator's override in $DUNE_CONFIG_DIR/UserSettings,
# else 1. dune-live is a fake that records its arguments; nothing reaches a broker.
cat > "$fake/dune-live" <<FAKE
#!$BASH
printf '%s\n' "\$*" > "$work/live-argv"
[ -e "$work/live-fails" ] && { echo "dune-live: publish failed (is the world up?)" >&2; exit 1; }
echo "sent AwardXP" >&2
FAKE
export DUNE_CONFIG_DIR="$work/config"
deployed="$root/DuneSandbox/Saved/UserSettings"; override="$DUNE_CONFIG_DIR/UserSettings"
mkdir -p "$deployed" "$override"
settings() { printf '[/Script/DuneSandbox.UserServerCustomSettings]\n; Possible values: 0 to 10\nGlobalXpMultiplier=%s\nCombatXp=1.000000\n' "$1"; }
settings 1.500000 > "$deployed/UserServerCustomSettings.ini"
settings 4.000000 > "$override/UserServerCustomSettings.ini"
live() { unlink "$work/live-argv" 2>/dev/null; DUNE_COMPONENTS_DIR="$fake" char "$@"; }
out=$(live xp "Some One" 4150 2>"$work/err"); rc=$?
[ "$rc" -eq 0 ] || fail "xp failed: rc=$rc $(cat "$work/err")"
[ "$(cat "$work/live-argv" 2>/dev/null)" = "character xp Some One 2767 Combat" ] || fail "xp at x1.5 did not send 2767: $(cat "$work/live-argv" 2>/dev/null)"
[[ "$out" == *"sent 2767"* && "$out" == *"x1.5"* && "$out" == *4150* ]] || fail "xp output does not show what was sent and why: $out"
json=$(live xp "Some One" 10 Gathering --json 2>"$work/err") || fail "xp --json failed: $(cat "$work/err")"
[ "$(cat "$work/live-argv" 2>/dev/null)" = "character xp Some One 7 Gathering" ] || fail "xp category or rounding: $(cat "$work/live-argv" 2>/dev/null)"
[ "$(jq -c '[.character, .requested, .multiplier, .sent, .category]' <<<"$json" 2>/dev/null)" = '["Some One",10,1.5,7,"Gathering"]' ] || fail "xp --json: $json"
[ "$(jq -r .multiplier_source <<<"$json" 2>/dev/null)" = "$deployed/UserServerCustomSettings.ini" ] || fail "xp --json does not name the settings file: $json"
unlink "$deployed/UserServerCustomSettings.ini"
live xp "Some One" 1000 >/dev/null 2>&1 && [ "$(cat "$work/live-argv" 2>/dev/null)" = "character xp Some One 250 Combat" ] || fail "xp did not fall back to the operator override (x4): $(cat "$work/live-argv" 2>/dev/null)"
unlink "$override/UserServerCustomSettings.ini"
out=$(live xp "Some One" 1000 2>&1) && [ "$(cat "$work/live-argv" 2>/dev/null)" = "character xp Some One 1000 Combat" ] || fail "xp without settings did not send as is: $(cat "$work/live-argv" 2>/dev/null) $out"
settings 0.000000 > "$deployed/UserServerCustomSettings.ini"
out=$(live xp "Some One" 1000 2>&1); [ $? -eq 1 ] && [[ "$out" == *GlobalXpMultiplier* ]] || fail "xp with GlobalXpMultiplier 0 not refused: $out"
settings lots > "$deployed/UserServerCustomSettings.ini"
out=$(live xp "Some One" 1000 2>&1); [ $? -eq 1 ] && [[ "$out" == *GlobalXpMultiplier* ]] || fail "xp with an unreadable multiplier not refused: $out"
[ -e "$work/live-argv" ] && fail "xp sent despite an unusable multiplier"
settings 1.500000 > "$deployed/UserServerCustomSettings.ini"
xp_bad() { live xp "$@" >/dev/null 2>&1; [ $? -eq 2 ] || fail "xp $* not a usage error"; }
xp_bad "Some One"; xp_bad "Some One" 0; xp_bad "Some One" -5; xp_bad "Some One" 1.5; xp_bad "Some One" ten
xp_bad "Some One" 10 Dancing; xp_bad "Some One" 10 Combat extra
[ -e "$work/live-argv" ] && fail "an xp usage error reached dune-live"
touch "$work/live-fails"
out=$(live xp "Some One" 4150 2>&1); [ $? -eq 1 ] && [[ "$out" == *"publish failed"* ]] && [[ "$out" != *"sent 2767"* ]] || fail "xp did not report dune-live's failure: $out"
unlink "$work/live-fails"

# level: XP total for level N from the game's curve (data/levels.tsv; 5390 for level 12, 5990 for 13, 7190 for 15),
# minus the character's TotalXPEarned, sent through the multiplier rounding up so the player reaches the threshold.
# Bob is online with 5806 XP (shown in game as about two thirds through level 12, docs/admin.md "Levels").
admin "insert into dune.fgl_entities values (-300, '{\"FLevelComponent\": [0, {\"TotalSkillPoints\": 11, \"UnspentSkillPoints\": 0, \"TotalXPEarned\": 5806}]}');
	insert into dune.actor_fgl_entities values (20, -300, 'DuneCharacter')"
out=$(live level Bob 13 2>"$work/err"); rc=$?
[ "$rc" -eq 0 ] || fail "level failed: rc=$rc $(cat "$work/err")"
[ "$(cat "$work/live-argv" 2>/dev/null)" = "character xp Bob 123 Combat" ] || fail "level 13 from 5806 XP at x1.5 did not send ceil(184 / 1.5) = 123: $(cat "$work/live-argv" 2>/dev/null)"
[[ "$out" == *"level 12"* && "$out" == *"level 13"* && "$out" == *184* && "$out" == *"sent 123"* ]] || fail "level output: $out"
json=$(live level Bob 15 --json 2>"$work/err") || fail "level --json failed: $(cat "$work/err")"
[ "$(jq -c '[.character, .xp_total, .level_before, .level, .xp_for_level, .needed, .multiplier, .sent]' <<<"$json" 2>/dev/null)" = '["Bob",5806,12,15,7190,1384,1.5,923]' ] || fail "level --json: $json"
out=$(live level Bob 12 2>&1); rc=$?
[ "$rc" -eq 0 ] && [[ "$out" == *already* ]] || fail "level to the current level: rc=$rc $out"
out=$(live level Bob 5 2>&1); rc=$?
[ "$rc" -eq 1 ] && [[ "$out" == *"cannot be removed"* ]] || fail "lowering a level not refused with the reason: rc=$rc $out"
[ -e "$work/live-argv" ] && fail "level sent XP while refusing"
out=$(live level Alice 5 2>&1); [ $? -eq 1 ] && [[ "$out" == *online* ]] || fail "level for an offline character not refused: $out"
out=$(live level DaveAlt 5 2>&1); [ $? -eq 1 ] && [[ "$out" == *XP* ]] || fail "level for a character without XP data not refused: $out"
for bad in "Bob" "Bob 0" "Bob 201" "Bob x" "Bob 2.5" "Bob 13 extra"; do
	# shellcheck disable=SC2086
	live level $bad >/dev/null 2>&1; [ $? -eq 2 ] || fail "level '$bad' not a usage error"
done
[ -e "$work/live-argv" ] && fail "a level usage error reached dune-live"
out=$(live level Nobody 5 2>&1); [ $? -eq 1 ] && [[ "$out" == *Nobody* ]] || fail "level for an unknown character: $out"

admin "alter table dune.encrypted_player_state rename column online_status to connection_state"
out=$(char set-intel Alice 7 2>&1) && fail "ran against a schema missing online_status"
[[ "$out" == *chema* ]] || fail "schema refusal does not say so: $out"
[ "$(intel 10)" = 105 ] || fail "wrote despite failed schema detection"
exit "$failures"
