#!/usr/bin/env bash
# libexec/dune-server configure: the map server's private ini overrides (0600, never on argv) carry the FLS token, the DB
# password and the server-command channel: a generated ServerCommandsAuthToken (kept in secrets/, stable across
# restarts) plus server.NotificationSystem.Enabled=true. They also carry the game's own in-game privileges: a generated
# admin password replacing Funcom's public default (DefaultGame.ini [AdminSetting.Global] Password_Admin=sardaukar),
# and a separate generated GM password for a trusted player, whose GM allow-list drops the Destroy* commands and
# AddItemToInventory ("-" entries remove them from Funcom's DedicatedServerGame.ini list).
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-server-config.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
export DUNE_STATE_DIR="$work/state" DUNE_SECRETS_DIR="$work/secrets" DUNE_SERVER_SRC="$work/src" DUNE_GLIBC_LOADER=/x DUNE_GCC_LIB=/x
export DUNE_WORLD_NAME=sh-test DUNE_PARTITION_INDEX=1
mkdir -p -m 700 "$DUNE_SECRETS_DIR"
printf 'dbpw\n' > "$DUNE_SECRETS_DIR/postgres_dune_password"; printf 'flstoken\n' > "$DUNE_SECRETS_DIR/fls_token"
out=$(libexec/dune-server configure 2>&1) || fail "configure failed: $out"
secret() { cat "$DUNE_SECRETS_DIR/$1" 2>/dev/null; }
tok="$DUNE_SECRETS_DIR/server_commands_token"
[ "$(stat -c %a "$tok" 2>/dev/null)" = 600 ] || fail "command token missing or not 0600"
[ "$(tr -d '\n' < "$tok" 2>/dev/null | wc -c)" -ge 32 ] || fail "command token too short"
ini="$DUNE_STATE_DIR/server/Saved/Config/LinuxServer/Engine.ini"
[ "$(stat -c %a "$ini" 2>/dev/null)" = 600 ] || fail "Engine.ini not 0600"
section() { awk -v s="[$1]" '$0 == s { on = 1; next } /^\[/ { on = 0 } on' "$ini"; }
section FuncomLiveServices | grep -qxF "ServerCommandsAuthToken=$(secret server_commands_token)" || fail "token not in [FuncomLiveServices]"
section ConsoleVariables | grep -qx 'server.NotificationSystem.Enabled=true' || fail "notification system not enabled in [ConsoleVariables]"
for pw in admin_password gm_password; do
	[ "$(stat -c %a "$DUNE_SECRETS_DIR/$pw" 2>/dev/null)" = 600 ] || fail "$pw missing or not 0600"
	# Typeable for players behind Tailscale: three Dune words and a two-digit number, e.g. sietch-thumper-kynes-42.
	[[ "$(secret "$pw")" =~ ^[a-z]+-[a-z]+-[a-z]+-[0-9]{2}$ ]] || fail "$pw is not a word-word-word-NN passphrase: $(secret "$pw" | sed 's/[a-z]/x/g')"
	secret "$pw" | grep -qi sardaukar && fail "$pw uses Funcom's public default word"
done
# Words come from the list in dune-server and vary: 20 fresh configures give at least 10 distinct passphrases.
seen=$(for i in $(seq 1 20); do mv "$DUNE_SECRETS_DIR/admin_password" "$work/old-$i" 2>/dev/null; libexec/dune-server configure >/dev/null 2>&1; secret admin_password; done | sort -u | wc -l)
[ "$seen" -ge 10 ] || fail "passphrases barely vary: $seen distinct of 20"
for w in $(secret admin_password | tr -- '-' ' ' | awk '{print $1, $2, $3}'); do
	grep -q "^PASSPHRASE_WORDS=.*\b$w\b" libexec/dune-server || fail "word $w not from the Dune word list"
done
[ "$(secret gm_password)" != "$(secret admin_password)" ] || fail "GM and admin passwords are the same"
# Randomness comes from the `random` tool (OS CSPRNG): a fake one on PATH that shuffles to a fixed order and rolls 42
# must yield exactly that passphrase; words are three distinct entries of the list, in the shuffled order.
fake="$work/fakebin"; mkdir -p "$fake"
printf '#!%s\nprintf "%%s\\n" "$*" >> "%s"\ncase " $* " in *" --shuffle "*) sort -r ;; *" 10-99 "*) echo 42 ;; *) exit 9 ;; esac\n' "$BASH" "$work/random-argv" > "$fake/random"
chmod +x "$fake/random"
mv "$DUNE_SECRETS_DIR/gm_password" "$work/gm-before-fake"
PATH="$fake:$PATH" libexec/dune-server configure >/dev/null 2>&1 || fail "configure with a fake random failed"
top3=$(sed -n 's/^PASSPHRASE_WORDS=(\(.*\))$/\1/p' libexec/dune-server | tr ' ' '\n' | sort -r | head -3 | paste -sd- -)
[ "$(secret gm_password)" = "$top3-42" ] || fail "passphrase not built from random's picks: $(secret gm_password | sed 's/[a-z]/x/g')"
grep -qs -- '--true-random' "$work/random-argv" || fail "random not called with --true-random (a DRANDOM_SEED in the environment would make passwords predictable)"
game="$DUNE_STATE_DIR/server/Saved/Config/LinuxServer/Game.ini"
[ "$(stat -c %a "$game" 2>/dev/null)" = 600 ] || fail "Game.ini not 0600"
gsection() { awk -v s="[$1]" '$0 == s { on = 1; next } /^\[/ { on = 0 } on' "$game"; }
# Plain keys (no +/-) replace Funcom's values in Unreal's ini layering; "-" entries remove items from its arrays.
# RequiresAdminPassword is a key the server reads from this section (GConfig GetBool, next to Password_%s); Funcom
# never sets it. True turns on the password-gated admin login (Admin Panel, Home key).
want=$(printf '%s\n' RequiresAdminPassword=True "Password_Admin=$(secret admin_password)" "Password_GM=$(secret gm_password)" \
	-Allowed_GM_Commands=AddItemToInventory -Allowed_GM_Commands=DestroyTargetVehicle -Allowed_GM_Commands=DestroyTotem \
	-Allowed_GM_Commands=DestroyPlaceable -Allowed_GM_Commands=DestroyEntireBuilding -Allowed_GM_Commands=DestroyBuildingPiece)
[ "$(gsection AdminSetting.Global)" = "$want" ] || fail "[AdminSetting.Global] wrong: $(gsection AdminSetting.Global | grep -v '^Password_')"
grep -rqi sardaukar "$DUNE_STATE_DIR/server/Saved/Config" && fail "public default admin password in the private config"
gsection DuneDatabaseInterfacePSQL | grep -qx 'DatabasePassword=dbpw' || fail "database settings lost from Game.ini"
first=$(secret server_commands_token) afirst=$(secret admin_password) gfirst=$(secret gm_password)
libexec/dune-server configure >/dev/null 2>&1 || fail "second configure failed"
[ "$(secret server_commands_token)" = "$first" ] || fail "command token changed across configure runs"
[ "$(secret admin_password)" = "$afirst" ] || fail "admin password changed across configure runs"
[ "$(secret gm_password)" = "$gfirst" ] || fail "GM password changed across configure runs"
exit "$failures"
