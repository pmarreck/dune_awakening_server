#!/usr/bin/env bash
# Host tier: bin/dune-awakening run from a bare environment (no devShell variables, minimal PATH, another cwd) must
# re-execute itself inside this project's nix develop and still work. Needs nix and the flake's inputs on the host.
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-world-nix.XXXXXX") || exit 1
trap 'rm -r -- "$work"' EXIT
mkdir -p -m 700 "$work/config"
printf 'WORLD_UNIQUE_NAME=sh-abc-qwerty\nWORLD_DISPLAY_NAME=%q\nWORLD_REGION=%q\n' "Bare Env" "North America" > "$work/config/world.conf"
# A component that is "up" only inside the real devShell (its glibc loader variable names an existing file).
mkdir -p "$work/bin"
printf '#!%s\n[ -e "${DUNE_GLIBC_LOADER:-/nonexistent}" ]\n' "$BASH" > "$work/bin/dune-postgres"
chmod +x "$work/bin/dune-postgres"
nix_dir=$(dirname -- "$(command -v nix)")
luajit_dir=$(dirname -- "$(command -v luajit)")
# TMPDIR stands in for the system /tmp (nix and the dev shell's mktemp use it when set, else /tmp).
mkdir -p "$work/systmp"
printf '#!%s\nprintf "%%s\\n" "${TMPDIR:-unset}" > "%s"\n' "$BASH" "$work/component-tmpdir" > "$work/bin/dune-rabbitmq"; chmod +x "$work/bin/dune-rabbitmq"
json=$(cd / && env -i HOME="$HOME" PATH="$nix_dir:$luajit_dir:/run/current-system/sw/bin" DUNE_CONFIG_DIR="$work/config" DUNE_COMPONENTS_DIR="$work/bin" \
	DUNE_STATE_DIR="$work/state" DUNE_UNPACKED_DIR="$work/unpacked" TMPDIR="$work/systmp" "$OLDPWD/bin/dune-awakening" status --json 2>"$work/err"); rc=$?
[ "$rc" -eq 1 ] || fail "bare-env status exited $rc (want 1: all down): $(tail -5 "$work/err")"
[ "$(jq -r '.world.display_name' <<<"$json" 2>/dev/null)" = "Bare Env" ] || fail "bare-env status did not reach the world config through nix: $json"
[ "$(jq -r '.components[0].up' <<<"$json" 2>/dev/null)" = true ] || fail "components did not run inside the devShell: $json"
# Each nix develop run used to leave an empty nix-develop-* and nix-shell.* directory in /tmp (about 288 a day from the
# heal timer). Now nix works in the private TMPDIR under the state dir, and the run removes its own directories there.
[ -z "$(ls -A "$work/systmp")" ] || fail "nix develop left directories in the system temp dir: $(ls -A "$work/systmp" | paste -sd' ' -)"
[ -d "$work/state/tmp" ] && [ -z "$(ls -A "$work/state/tmp")" ] || fail "private temp dir missing or not cleaned: $(ls -A "$work/state/tmp" 2>&1 | paste -sd' ' -)"
[ "$(cat "$work/component-tmpdir" 2>/dev/null)" = "$work/state/tmp" ] || fail "components not given the private TMPDIR: $(cat "$work/component-tmpdir" 2>/dev/null)"
exit "$failures"
