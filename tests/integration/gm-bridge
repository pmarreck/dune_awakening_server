#!/usr/bin/env bash
# libexec/dune-gm-bridge against a real game broker (libexec/dune-rabbitmq): TextChat messages published into
# chat.intercept with a broker-style user_id, a fake dune-live that records argv and answers whois. Checks: an allowed
# command runs exactly its argv (player text verbatim, never shell-interpreted) and whispers a reply; an unlisted sender
# gets only "not allowed"; ordinary chat produces nothing and is never logged; a message without user_id is ignored.
# The bridge starts before chat.intercept exists, so its retry path runs too. Hermetic (runs in the Nix check).
set -u
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." || exit 1
. tests/lib/ports.bash
. tests/lib/chat.bash
failures=0
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }
work=$(mktemp -d "${TMPDIR:-/tmp}/dune-gm-bridge-test.XXXXXX") || exit 1
base=$(pick_port_base 6) || { printf "FAIL no free port block\n" >&2; exit 1; }
export DUNE_STATE_DIR="$work/state" DUNE_SECRETS_DIR="$work/secrets" DUNE_CONFIG_DIR="$work/config"
export DUNE_RMQ_GAME_PORT=$base DUNE_RMQ_AUTH_ADDRESS="127.0.0.1:$((base + 1))" ERL_EPMD_PORT=$((base + 2))
export DUNE_RMQ_DIST_BASE=$((base + 3)) DUNE_RMQ_GAME_LOCAL_PORT=$((base + 5))
export DUNE_LIVE="$work/fake live/dune-live" DUNE_GM_BRIDGE_RETRY_MAX=0.2
bridge_pid=
cleanup() {
	[ -n "$bridge_pid" ] && kill "$bridge_pid" 2>/dev/null
	libexec/dune-gm-bridge stop >/dev/null 2>&1
	libexec/dune-rabbitmq stop game >/dev/null 2>&1
	stop_epmd "$ERL_EPMD_PORT"
	rm -r -- "$work"
}
trap cleanup EXIT
mkdir -p -m 700 "$DUNE_CONFIG_DIR" "$work/fake live"
ALICE=0123456789ABCDEF BOB=FEDCBA9876543210 CAROL=00000000000000AA DAVE=00000000000000BB

# Fake dune-live: one line per call, arguments separated by \x1f; whois knows three accounts; moving to Nobody fails.
cat > "$DUNE_LIVE" <<FAKE
#!$BASH
{ printf '%s\x1f' "\$@"; printf '\n'; } >> "$work/calls"
case "\$1 \$2" in
	"character whois") case "\$3" in $ALICE) echo Alice ;; $BOB) echo Bob ;; $CAROL) echo Carol ;; *) echo "dune-live: no character for account \$3" >&2; exit 1 ;; esac ;;
	"character move") [ "\$5" = Nobody ] && { echo "dune-live: no character named Nobody with a body in the world" >&2; exit 1; } ;;
	"character give") [ "\$3" = Nobody ] && { echo "dune-live: Nobody is not online; items can only be given to an online player" >&2; exit 1; } ;;
esac
exit 0
FAKE
chmod +x "$DUNE_LIVE"
printf '# who: commands\nAlice: *\n%s: where give\n' "$BOB" > "$DUNE_CONFIG_DIR/gm_bridge.conf"
# The generated item list (private in real use: derived from the game's tables); here a synthetic stand-in.
export DUNE_ITEMS_GENERATED="$work/items generated.tsv"
printf 'FremenComponent1\tEMF Generator\t0\nD_FremenComponent3\tEMF Generator\t1\nSolarisCoin\tSolari\t0\n' > "$DUNE_ITEMS_GENERATED"

libexec/dune-gm-bridge --help >/dev/null 2>&1 || fail "--help"
out=$(libexec/dune-gm-bridge --about 2>&1); [[ "$out" == dune-gm-bridge* && "$(wc -l <<<"$out")" -eq 1 ]] || fail "--about: $out"
libexec/dune-gm-bridge bogus >/dev/null 2>&1; [ $? -eq 2 ] || fail "unknown action is not a usage error"
libexec/dune-gm-bridge status && fail "status says running before start"

out=$(libexec/dune-rabbitmq init game 2>&1 && libexec/dune-rabbitmq start game 2>&1) || { fail "game broker: $out"; exit 1; }
log="$DUNE_STATE_DIR/gm-bridge/gm-bridge.log"
libexec/dune-gm-bridge run --max-messages 10 > "$work/run.out" 2>&1 &
bridge_pid=$!
# Before chat.intercept exists the bridge retries; once it exists, it binds and logs that it is listening.
for _ in $(seq 1 30); do grep -q 'retrying' "$log" 2>/dev/null && break; sleep 0.1; done
grep -q 'retrying' "$log" 2>/dev/null || fail "no retry logged while chat.intercept is missing: $(cat "$log" 2>/dev/null)"
declare_exchange chat.intercept topic || fail "cannot declare chat.intercept"
for _ in $(seq 1 100); do grep -q 'listening' "$log" 2>/dev/null && break; sleep 0.1; done
grep -q 'listening' "$log" 2>/dev/null || fail "bridge never listened: $(cat "$log" "$work/run.out" 2>/dev/null)"
# The same broker error, retried many times, is logged once (a world whose broker predates the bridge's listener
# would otherwise add a line every 30 s until its next restart).
[ "$(grep -c 'retrying' "$log")" -eq 1 ] || fail "repeated broker error logged more than once: $(grep 'retrying' "$log")"

say_text="Restart in 5; \$(touch $work/pwned) \`touch $work/pwned\` 'q' \"dq\""
send() { text_chat "$2" Proximity "$3" "$4" "$5" "$6" > "$work/msg.json" && publish_chat chat.intercept "$2" "$1" "$work/msg.json" || fail "publish: $3"; }
send "$ALICE" 'Alice#1234' "&say $say_text" 1 2 3
send "$ALICE" 'Alice#1234' 'hello everyone secret-phrase-xyz' 1 2 3
send "$CAROL" 'Carol#77' '&goto Alice' 1 2 3
send '' 'Alice#1234' '&say no-user-id-marker' 1 2 3
send "$BOB" 'Bob#5' '&where' 1.4 2.6 -3.4
send "$ALICE" 'Alice#1234' '&goto Nobody' 1 2 3
send "$DAVE" 'Alice#1234' '&say dave-marker' 1 2 3
send "$ALICE" 'Alice#1234' '&give emf generator 2 to Bob' 1 2 3
send "$BOB" 'Bob#5' '&give solari 5 to Alice' 1 2 3
send "$ALICE" 'Alice#1234' '&give solari to Nobody' 1 2 3
for _ in $(seq 1 300); do kill -0 "$bridge_pid" 2>/dev/null || break; sleep 0.1; done
if kill -0 "$bridge_pid" 2>/dev/null; then fail "bridge did not exit after 10 messages"; kill "$bridge_pid"; fi
wait "$bridge_pid"; rc=$?; bridge_pid=
[ "$rc" -eq 0 ] || fail "bridge run exited $rc: $(cat "$work/run.out")"
[ -s "$work/run.out" ] && fail "bridge run wrote to stdout/stderr: $(cat "$work/run.out")"

us=$'\x1f'
expected=$(printf '%s\n' \
	"character${us}whois${us}$ALICE${us}" \
	"world${us}say${us}$say_text${us}" \
	"character${us}whisper${us}Alice${us}announced${us}--from${us}GM${us}" \
	"character${us}whois${us}$CAROL${us}" \
	"character${us}whisper${us}Carol${us}not allowed${us}--from${us}GM${us}" \
	"character${us}whois${us}$BOB${us}" \
	"character${us}whisper${us}Bob${us}you are at X 1 Y 3 Z -3${us}--from${us}GM${us}" \
	"character${us}whois${us}$ALICE${us}" \
	"character${us}move${us}Alice${us}to${us}Nobody${us}" \
	"character${us}whisper${us}Alice${us}failed: no character named Nobody with a body in the world${us}--from${us}GM${us}" \
	"character${us}whois${us}$DAVE${us}" \
	"character${us}whois${us}$ALICE${us}" \
	"character${us}give${us}Bob${us}FremenComponent1${us}2${us}" \
	"character${us}whisper${us}Alice${us}gave Bob 2 EMF Generator (FremenComponent1); a full inventory can drop items${us}--from${us}GM${us}" \
	"character${us}whois${us}$BOB${us}" \
	"character${us}whisper${us}Bob${us}not allowed${us}--from${us}GM${us}" \
	"character${us}whois${us}$ALICE${us}" \
	"character${us}give${us}Nobody${us}SolarisCoin${us}1${us}" \
	"character${us}whisper${us}Alice${us}failed: Nobody is not online; items can only be given to an online player${us}--from${us}GM${us}")
got=$(cat "$work/calls" 2>/dev/null)
[ "$got" = "$expected" ] || fail "dune-live calls:
$(tr "$us" '|' <<<"$got")
want:
$(tr "$us" '|' <<<"$expected")"
[ -e "$work/pwned" ] && fail "player text was interpreted by a shell"
[ "$(stat -c %a "$log" 2>/dev/null)" = 600 ] || fail "log not 0600"
grep -q 'secret-phrase-xyz\|hello everyone' "$log" && fail "ordinary chat appears in the log"
grep -q 'no-user-id-marker' "$log" && fail "a message without user_id was logged"
grep -q "$CAROL Carol denied: &goto Alice" "$log" || fail "denied command not logged: $(cat "$log")"
grep -q "$ALICE Alice allowed: &say" "$log" || fail "allowed command not logged: $(cat "$log")"
grep -q "$DAVE .*dave-marker" "$log" || fail "unknown account's command not logged: $(cat "$log")"

# Component interface: start, status, stop.
out=$(libexec/dune-gm-bridge start 2>&1) || fail "start: $out"
libexec/dune-gm-bridge status || fail "status after start"
for _ in $(seq 1 100); do [ "$(grep -c 'listening' "$log")" -ge 2 ] && break; sleep 0.1; done
[ "$(grep -c 'listening' "$log")" -ge 2 ] || fail "started bridge never listened: $(tail -3 "$log")"
# A dropped connection (broker restart, forced close) is logged and the bridge reconnects.
libexec/dune-rabbitmq ctl game close_all_connections "test drop" >/dev/null 2>&1 || fail "cannot close connections"
for _ in $(seq 1 100); do [ "$(grep -c 'listening' "$log")" -ge 3 ] && break; sleep 0.1; done
[ "$(grep -c 'listening' "$log")" -ge 3 ] || fail "bridge did not reconnect after a forced close: $(tail -3 "$log")"
grep -q 'CONNECTION_FORCED' "$log" || fail "forced close not logged: $(tail -3 "$log")"
pid=$(cat "$DUNE_STATE_DIR/gm-bridge/pid" 2>/dev/null)
out=$(libexec/dune-gm-bridge start 2>&1) || fail "second start: $out"
[ "$(cat "$DUNE_STATE_DIR/gm-bridge/pid" 2>/dev/null)" = "$pid" ] && [ -n "$pid" ] || fail "second start replaced the running bridge"
out=$(libexec/dune-gm-bridge stop 2>&1) || fail "stop: $out"
libexec/dune-gm-bridge status && fail "status says running after stop"
exit "$failures"
